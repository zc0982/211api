#!/usr/bin/env bash

set -euo pipefail
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset BASH_ENV ENV CDPATH GLOBIGNORE

SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
INSTALL_ROOT=
ENABLE_GITEA=0

usage() {
  printf 'Usage: install-netcup-host-controls [--test-root /tmp/DIR] [--enable-gitea]\n' >&2
  exit 64
}

while (($#)); do
  case "$1" in
    --test-root)
      (($# >= 2)) || usage
      [[ -z "$INSTALL_ROOT" ]] || usage
      INSTALL_ROOT=$2
      shift 2
      ;;
    --enable-gitea)
      ENABLE_GITEA=1
      shift
      ;;
    *) usage ;;
  esac
done

if [[ -n "$INSTALL_ROOT" ]]; then
  [[ "$INSTALL_ROOT" == /tmp/* && -d "$INSTALL_ROOT" && ! -L "$INSTALL_ROOT" ]] || usage
  [[ "$(stat -c '%u' "$INSTALL_ROOT")" == "$EUID" ]] || usage
else
  ((EUID == 0)) || {
    printf 'install-netcup-host-controls: root privileges are required\n' >&2
    exit 1
  }
  [[ "$SOURCE_DIR" == /opt/gitea/host ]] || {
    printf 'install-netcup-host-controls: run the reviewed canonical /opt/gitea/host installer\n' >&2
    exit 1
  }
fi

EXPECTED_OWNER=$([[ -n "$INSTALL_ROOT" ]] && printf '%s' "$EUID" || printf '0')
EXPECTED_GROUP=$([[ -n "$INSTALL_ROOT" ]] && id -g || printf '0')
PROGRAM="$INSTALL_ROOT/usr/local/sbin/gitea-netcup-firewall"
FAIL2BAN_RELOAD="$INSTALL_ROOT/usr/local/sbin/gitea-fail2ban-reload"
UNIT="$INSTALL_ROOT/etc/systemd/system/gitea-netcup-firewall.service"
SSHD_JAIL="$INSTALL_ROOT/etc/fail2ban/jail.d/211api-sshd.local"
GITEA_JAIL="$INSTALL_ROOT/etc/fail2ban/jail.d/211api-gitea.local"
GITEA_ENABLE="$INSTALL_ROOT/etc/fail2ban/jail.d/zz-211api-gitea-enable.local"
GITEA_FILTER="$INSTALL_ROOT/etc/fail2ban/filter.d/gitea-auth.conf"
CHECKSUM_RECORD="$INSTALL_ROOT/etc/gitea/netcup-host-controls.sha256"
GITEA_LOG="$INSTALL_ROOT/opt/gitea/platform/log/gitea.log"
LOCK_TIMEOUT=30

declare -a TX_SOURCES=()
declare -a TX_DESTINATIONS=()
declare -a TX_MODES=()
declare -a TX_STAGES=()
declare -a TX_BACKUPS=()
declare -a TX_EXISTED=()
TX_ACTIVE=0

die() {
  printf 'install-netcup-host-controls: %s\n' "$1" >&2
  exit 1
}

for command in awk basename chmod chown cp dirname flock id install mktemp mv \
  readlink rm sha256sum sleep stat sync; do
  command -v "$command" >/dev/null 2>&1 || die "required installer command is missing: $command"
done

if [[ -z "$INSTALL_ROOT" ]]; then
  for command in fail2ban-client ip ip6tables ip6tables-restore iptables \
    iptables-restore ufw; do
    command -v "$command" >/dev/null 2>&1 || die "required runtime command is missing: $command"
  done
fi

if [[ -n "${NETCUP_HOST_INSTALL_TEST_LOCK_TIMEOUT:-}" ]]; then
  [[ -n "$INSTALL_ROOT" && "$NETCUP_HOST_INSTALL_TEST_LOCK_TIMEOUT" == 0 ]] ||
    die 'test lock-timeout override is forbidden or invalid'
  LOCK_TIMEOUT=0
fi

case "${NETCUP_HOST_INSTALL_TEST_FAULT:-}" in
  "") ;;
  after-first-commit | after-final-commit)
    [[ -n "$INSTALL_ROOT" ]] || die 'test fault injection is forbidden in production mode'
    ;;
  *) die "unknown test fault: $NETCUP_HOST_INSTALL_TEST_FAULT" ;;
esac

require_source() {
  local path=$1
  [[ -f "$path" && ! -L "$path" ]] || die "unsafe or missing source: $path"
  [[ "$(stat -c '%u' "$path")" == "$EUID" ]] ||
    die "source is not owned by the installer caller: $path"
}

ensure_host_parent() {
  local path=$1 expected_mode=${2:-}
  if [[ ! -e "$path" && -n "$INSTALL_ROOT" ]]; then
    install -d -o "$EXPECTED_OWNER" -g "$EXPECTED_GROUP" -m "${expected_mode:-0755}" "$path"
  fi
  [[ -d "$path" && ! -L "$path" ]] || die "required host directory is missing: $path"
  [[ "$(stat -c '%u:%g' "$path")" == "$EXPECTED_OWNER:$EXPECTED_GROUP" ]] ||
    die "host directory owner or group conflicts: $path"
  if [[ -n "$expected_mode" ]]; then
    [[ "$(stat -c '%a' "$path")" == "$expected_mode" ]] ||
      die "host directory mode conflicts: $path"
  else
    case "$(stat -c '%a' "$path")" in
      700 | 750 | 755) ;;
      *) die "host directory mode conflicts: $path" ;;
    esac
  fi
}

validate_destination() {
  local destination=$1 mode=$2
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" ]] || die "conflicting file path: $destination"
    [[ "$(stat -c '%u:%g:%a' "$destination")" == "$EXPECTED_OWNER:$EXPECTED_GROUP:$mode" ]] ||
      die "file ownership or mode conflicts: $destination"
  fi
}

validate_gitea_log() {
  local expected_log_owner expected_log_group parent
  parent="$(dirname "$GITEA_LOG")"
  if [[ -n "$INSTALL_ROOT" ]]; then
    expected_log_owner=$EUID
    expected_log_group="$(id -g)"
  else
    expected_log_owner=1000
    expected_log_group=1000
  fi
  [[ -d "$parent" && ! -L "$parent" ]] ||
    die "Gitea log directory is missing or unsafe: $parent"
  [[ "$(stat -c '%u:%g:%a' "$parent")" == \
    "$expected_log_owner:$expected_log_group:750" ]] ||
    die "Gitea log directory owner, group, or mode conflicts: $parent"
  [[ -f "$GITEA_LOG" && ! -L "$GITEA_LOG" && -s "$GITEA_LOG" ]] ||
    die "Gitea jail requires a non-empty regular log: $GITEA_LOG"
  [[ "$(stat -c '%u:%g' "$GITEA_LOG")" == \
    "$expected_log_owner:$expected_log_group" ]] ||
    die "Gitea log owner or group conflicts: $GITEA_LOG"
}

queue_install() {
  local source=$1 destination=$2 mode=$3
  require_source "$source"
  validate_destination "$destination" "$mode"
  TX_SOURCES+=("$source")
  TX_DESTINATIONS+=("$destination")
  TX_MODES+=("$mode")
}

cleanup_transaction() {
  local path
  for path in "${TX_STAGES[@]}" "${TX_BACKUPS[@]}"; do
    [[ -z "$path" ]] || rm -f -- "$path"
  done
}

rollback_transaction() {
  local i destination backup status=0
  for ((i=${#TX_DESTINATIONS[@]} - 1; i >= 0; i--)); do
    destination=${TX_DESTINATIONS[$i]}
    backup=${TX_BACKUPS[$i]}
    if [[ "${TX_EXISTED[$i]}" == 1 ]]; then
      mv -f -- "$backup" "$destination" || status=1
      TX_BACKUPS[$i]=
    else
      rm -f -- "$destination" || status=1
    fi
    sync -f "$(dirname "$destination")" || status=1
  done
  return "$status"
}

transaction_exit() {
  local status=$? rollback_status=0
  trap - EXIT
  set +e
  if ((TX_ACTIVE)) && ((status != 0)); then
    rollback_transaction || rollback_status=$?
    if ((rollback_status != 0)); then
      printf 'install-netcup-host-controls: rollback failed; manual intervention is required\n' >&2
      status=70
    fi
  fi
  cleanup_transaction
  exit "$status"
}

stage_transaction() {
  local i source destination mode parent stage before after staged record_stage hash
  local install_count=${#TX_SOURCES[@]}

  for ((i=0; i<install_count; i++)); do
    source=${TX_SOURCES[$i]}
    destination=${TX_DESTINATIONS[$i]}
    mode=${TX_MODES[$i]}
    parent="$(dirname "$destination")"
    require_source "$source"
    before="$(sha256sum "$source" | awk '{print $1}')"
    stage="$(mktemp "$parent/.gitea-host-stage.$(basename "$destination").XXXXXXXX")"
    install -o "$EXPECTED_OWNER" -g "$EXPECTED_GROUP" -m "$mode" "$source" "$stage"
    after="$(sha256sum "$source" | awk '{print $1}')"
    staged="$(sha256sum "$stage" | awk '{print $1}')"
    [[ "$before" == "$after" && "$after" == "$staged" ]] ||
      die "source changed or staged checksum mismatched: $source"
    [[ "$(stat -c '%u:%g:%a' "$stage")" == "$EXPECTED_OWNER:$EXPECTED_GROUP:$mode" ]] ||
      die "staged ownership or mode mismatch: $destination"
    sync -f "$stage"
    TX_STAGES+=("$stage")
  done

  validate_destination "$CHECKSUM_RECORD" 600
  record_stage="$(mktemp "$(dirname "$CHECKSUM_RECORD")/.gitea-host-stage.checksums.XXXXXXXX")"
  : >"$record_stage"
  for ((i=0; i<install_count; i++)); do
    hash="$(sha256sum "${TX_STAGES[$i]}" | awk '{print $1}')"
    printf '%s  %s\n' "$hash" "${TX_DESTINATIONS[$i]}" >>"$record_stage"
  done
  chown "$EXPECTED_OWNER:$EXPECTED_GROUP" "$record_stage"
  chmod 0600 "$record_stage"
  sync -f "$record_stage"
  TX_SOURCES+=("")
  TX_DESTINATIONS+=("$CHECKSUM_RECORD")
  TX_MODES+=("600")
  TX_STAGES+=("$record_stage")
}

prepare_backups() {
  local destination parent backup
  for destination in "${TX_DESTINATIONS[@]}"; do
    parent="$(dirname "$destination")"
    backup="$(mktemp "$parent/.gitea-host-backup.$(basename "$destination").XXXXXXXX")"
    if [[ -e "$destination" ]]; then
      cp --reflink=auto --preserve=mode,ownership,timestamps -- "$destination" "$backup"
      TX_EXISTED+=("1")
    else
      rm -f -- "$backup"
      TX_EXISTED+=("0")
    fi
    TX_BACKUPS+=("$backup")
  done
}

commit_transaction() {
  local i destination stage
  prepare_backups
  TX_ACTIVE=1
  for ((i=0; i<${#TX_DESTINATIONS[@]}; i++)); do
    destination=${TX_DESTINATIONS[$i]}
    stage=${TX_STAGES[$i]}
    mv -f -- "$stage" "$destination"
    TX_STAGES[$i]=
    sync -f "$(dirname "$destination")"
    if [[ "${NETCUP_HOST_INSTALL_TEST_FAULT:-}" == after-first-commit && "$i" == 0 ]]; then
      return 91
    fi
  done
  if [[ "${NETCUP_HOST_INSTALL_TEST_FAULT:-}" == after-final-commit ]]; then
    return 91
  fi
  sha256sum --quiet --check "$CHECKSUM_RECORD" || die 'installed checksum record does not verify'
  TX_ACTIVE=0
  cleanup_transaction
}

for source in \
  netcup-firewall \
  gitea-fail2ban-reload \
  gitea-netcup-firewall.service \
  fail2ban/jail.d/211api-sshd.local \
  fail2ban/jail.d/211api-gitea.local \
  fail2ban/jail.d/zz-211api-gitea-enable.local \
  fail2ban/filter.d/gitea-auth.conf; do
  require_source "$SOURCE_DIR/$source"
done

ensure_host_parent "$INSTALL_ROOT/usr"
ensure_host_parent "$INSTALL_ROOT/usr/local"
ensure_host_parent "$INSTALL_ROOT/usr/local/sbin"
ensure_host_parent "$INSTALL_ROOT/etc"
ensure_host_parent "$INSTALL_ROOT/etc/systemd"
ensure_host_parent "$INSTALL_ROOT/etc/systemd/system"
ensure_host_parent "$INSTALL_ROOT/etc/fail2ban"
ensure_host_parent "$INSTALL_ROOT/etc/fail2ban/jail.d"
ensure_host_parent "$INSTALL_ROOT/etc/fail2ban/filter.d"
ensure_host_parent "$INSTALL_ROOT/etc/gitea" 700

exec 8<"$INSTALL_ROOT/etc/gitea"
flock -w "$LOCK_TIMEOUT" 8 || die 'timed out waiting for the installer lock'

trap transaction_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

queue_install "$SOURCE_DIR/netcup-firewall" "$PROGRAM" 755
queue_install "$SOURCE_DIR/gitea-fail2ban-reload" "$FAIL2BAN_RELOAD" 755
queue_install "$SOURCE_DIR/gitea-netcup-firewall.service" "$UNIT" 644
queue_install "$SOURCE_DIR/fail2ban/jail.d/211api-sshd.local" "$SSHD_JAIL" 644
queue_install "$SOURCE_DIR/fail2ban/jail.d/211api-gitea.local" "$GITEA_JAIL" 644
queue_install "$SOURCE_DIR/fail2ban/filter.d/gitea-auth.conf" "$GITEA_FILTER" 644

if ((ENABLE_GITEA)); then
  validate_gitea_log
  queue_install "$SOURCE_DIR/fail2ban/jail.d/zz-211api-gitea-enable.local" \
    "$GITEA_ENABLE" 644
elif [[ -e "$GITEA_ENABLE" || -L "$GITEA_ENABLE" ]]; then
  die 'Gitea jail is already enabled; rerun explicitly with --enable-gitea'
fi

stage_transaction
commit_transaction

printf 'Installed Netcup host controls (Gitea jail enabled: %s):\n' "$ENABLE_GITEA"
while IFS= read -r line; do
  printf '  %s\n' "$line"
done <"$CHECKSUM_RECORD"
