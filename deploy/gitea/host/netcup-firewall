#!/usr/bin/env bash

set -euo pipefail
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset BASH_ENV ENV CDPATH GLOBIGNORE

readonly PUBLIC_INTERFACE=ens3
readonly PUBLIC_IPV4=37.221.194.27
readonly IPV4_CHAIN=GITEA-GUARD
readonly IPV6_CHAIN=GITEA6-GUARD
readonly IPV4_COMMENT=gitea-platform-guard-v1
readonly IPV6_COMMENT=gitea-platform-guard-v6-v1
readonly LOCK_FILE=/run/lock/gitea-netcup-firewall.lock

ROLLBACK_ACTIVE=0
ROLLBACK_DIR=

die() {
  printf 'gitea-netcup-firewall: %s\n' "$1" >&2
  exit 1
}

usage() {
  printf 'Usage: gitea-netcup-firewall {apply|verify}\n' >&2
  exit 64
}

require_runtime() {
  local command
  ((EUID == 0)) || die 'root privileges are required'
  for command in flock ip ip6tables ip6tables-restore iptables iptables-restore mktemp; do
    command -v "$command" >/dev/null 2>&1 || die "required command is missing: $command"
  done
  [[ -d /run/lock && ! -L /run/lock ]] || die 'unsafe /run/lock directory'
  ip -4 -o address show dev "$PUBLIC_INTERFACE" | awk -v expected="$PUBLIC_IPV4/" '
    index($4, expected) == 1 { found = 1 }
    END { exit(found ? 0 : 1) }
  ' || die "expected $PUBLIC_IPV4 is not assigned to $PUBLIC_INTERFACE"
  iptables -w 10 -S DOCKER-USER >/dev/null 2>&1 || die 'IPv4 DOCKER-USER chain is missing'
  ip6tables -w 10 -S DOCKER-USER >/dev/null 2>&1 || die 'IPv6 DOCKER-USER chain is missing'
}

render_ipv4_restore() {
  cat <<EOF
*filter
:$IPV4_CHAIN - [0:0]
-F $IPV4_CHAIN
-A $IPV4_CHAIN -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A $IPV4_CHAIN ! -i $PUBLIC_INTERFACE -j RETURN
-A $IPV4_CHAIN -i $PUBLIC_INTERFACE -p tcp -m conntrack --ctstate NEW --ctorigdst $PUBLIC_IPV4 --ctorigdstport 2222 --ctdir ORIGINAL -m hashlimit --hashlimit-upto 30/minute --hashlimit-burst 20 --hashlimit-mode srcip --hashlimit-name gitea_ssh_v4 --hashlimit-htable-expire 60000 -j ACCEPT
-A $IPV4_CHAIN -i $PUBLIC_INTERFACE -p tcp -m conntrack --ctstate NEW --ctorigdst $PUBLIC_IPV4 --ctorigdstport 2222 --ctdir ORIGINAL -j DROP
-A $IPV4_CHAIN -i $PUBLIC_INTERFACE -p tcp -m conntrack --ctstate NEW --ctorigdst $PUBLIC_IPV4 --ctorigdstport 80 --ctdir ORIGINAL -j ACCEPT
-A $IPV4_CHAIN -i $PUBLIC_INTERFACE -p tcp -m conntrack --ctstate NEW --ctorigdst $PUBLIC_IPV4 --ctorigdstport 443 --ctdir ORIGINAL -j ACCEPT
-A $IPV4_CHAIN -i $PUBLIC_INTERFACE -j DROP
-A $IPV4_CHAIN -j RETURN
COMMIT
EOF
}

render_ipv6_restore() {
  cat <<EOF
*filter
:$IPV6_CHAIN - [0:0]
-F $IPV6_CHAIN
-A $IPV6_CHAIN -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A $IPV6_CHAIN ! -i $PUBLIC_INTERFACE -j RETURN
-A $IPV6_CHAIN -i $PUBLIC_INTERFACE -j DROP
-A $IPV6_CHAIN -j RETURN
COMMIT
EOF
}

validate_jump_order() {
  local binary=$1 guard=$2 comment=$3 allow_missing=$4
  local rule guard_count=0 seen_guard=0 seen_return=0

  while IFS= read -r rule; do
    [[ "$rule" == -A\ DOCKER-USER* ]] || continue
    ((seen_return == 0)) || die "rule follows the terminal DOCKER-USER return in $binary: $rule"
    if [[ "$rule" == *" -j $guard" ]]; then
      [[ "$rule" == "-A DOCKER-USER -m comment --comment $comment -j $guard" ]] ||
        die "unexpected managed jump shape in $binary: $rule"
      guard_count=$((guard_count + 1))
      seen_guard=1
    elif [[ "$rule" == '-A DOCKER-USER -p tcp -m multiport --dports 2222 -j f2b-gitea-auth' ]]; then
      ((seen_guard == 0)) || die "Fail2ban jump follows the managed guard in $binary"
      "$binary" -w 10 -S f2b-gitea-auth >/dev/null 2>&1 ||
        die "Fail2ban jump has no matching chain in $binary"
    elif [[ "$rule" == '-A DOCKER-USER -j RETURN' ]]; then
      ((seen_guard == 1 || allow_missing == 1)) ||
        die "terminal DOCKER-USER return precedes the managed guard in $binary"
      seen_return=1
    else
      die "unowned DOCKER-USER rule in $binary: $rule"
    fi
  done < <("$binary" -w 10 -S DOCKER-USER)

  ((guard_count <= 1)) || die "duplicate managed jump in $binary"
  if ((allow_missing == 0)); then
    ((guard_count == 1)) || die "managed jump is missing in $binary"
  fi
}

snapshot_family() {
  local binary=$1 chain=$2 comment=$3 prefix=$4
  if "$binary" -w 10 -S "$chain" >/dev/null 2>&1; then
    printf '1\n' >"$prefix.exists"
    {
      printf '*filter\n:%s - [0:0]\n-F %s\n' "$chain" "$chain"
      "$binary" -w 10 -S "$chain" | awk -v chain="$chain" '$1 == "-A" && $2 == chain'
      printf 'COMMIT\n'
    } >"$prefix.restore"
  else
    printf '0\n' >"$prefix.exists"
    : >"$prefix.restore"
  fi
  if "$binary" -w 10 -C DOCKER-USER -m comment --comment "$comment" -j "$chain" \
    >/dev/null 2>&1; then
    printf '1\n' >"$prefix.jump"
  else
    printf '0\n' >"$prefix.jump"
  fi
}

rollback_family() {
  local binary=$1 restore_binary=$2 chain=$3 comment=$4 prefix=$5 status=0
  if [[ "$(<"$prefix.jump")" == 0 ]] &&
    "$binary" -w 10 -C DOCKER-USER -m comment --comment "$comment" -j "$chain" \
      >/dev/null 2>&1; then
    "$binary" -w 10 -D DOCKER-USER -m comment --comment "$comment" -j "$chain" || status=1
  fi
  if [[ "$(<"$prefix.exists")" == 1 ]]; then
    "$restore_binary" -w 10 --noflush <"$prefix.restore" || status=1
  elif "$binary" -w 10 -S "$chain" >/dev/null 2>&1; then
    "$binary" -w 10 -F "$chain" || status=1
    "$binary" -w 10 -X "$chain" || status=1
  fi
  return "$status"
}

rollback_apply() {
  local status=0
  rollback_family iptables iptables-restore "$IPV4_CHAIN" "$IPV4_COMMENT" \
    "$ROLLBACK_DIR/ipv4" || status=1
  rollback_family ip6tables ip6tables-restore "$IPV6_CHAIN" "$IPV6_COMMENT" \
    "$ROLLBACK_DIR/ipv6" || status=1
  return "$status"
}

on_exit() {
  local status=$? rollback_status=0
  trap - EXIT
  set +e
  if ((ROLLBACK_ACTIVE)) && ((status != 0)); then
    rollback_apply || rollback_status=$?
    if ((rollback_status != 0)); then
      printf 'gitea-netcup-firewall: rollback failed; manual intervention is required\n' >&2
      status=70
    fi
  fi
  [[ -z "$ROLLBACK_DIR" ]] || rm -rf -- "$ROLLBACK_DIR"
  exit "$status"
}

validate_test_fault() {
  local namespace_host_uid
  [[ -z "${GITEA_FIREWALL_TEST_FAULT:-}" ]] && return 0
  namespace_host_uid="$(awk '$1 == 0 { print $2; exit }' /proc/self/uid_map)"
  [[ "$namespace_host_uid" != 0 ]] || die 'test fault injection is forbidden in the initial user namespace'
  case "$GITEA_FIREWALL_TEST_FAULT" in
    after-ipv4 | after-ipv6 | after-ipv4-jump) ;;
    *) die "unknown test fault: $GITEA_FIREWALL_TEST_FAULT" ;;
  esac
}

inject_test_fault() {
  local point=$1
  [[ "${GITEA_FIREWALL_TEST_FAULT:-}" != "$point" ]] || return 91
}

validate_guard_references() {
  local binary=$1 guard=$2 comment=$3 rule
  while IFS= read -r rule; do
    [[ "$rule" == *" -j $guard" ]] || continue
    [[ "$rule" == "-A DOCKER-USER -m comment --comment $comment -j $guard" ]] ||
      die "managed guard has an external reference in $binary: $rule"
  done < <("$binary" -w 10 -S)
}

ensure_jump() {
  local binary=$1 guard=$2 comment=$3
  local insert_position
  validate_jump_order "$binary" "$guard" "$comment" 1
  if ! "$binary" -w 10 -C DOCKER-USER -m comment --comment "$comment" -j "$guard" \
    >/dev/null 2>&1; then
    if "$binary" -w 10 -C DOCKER-USER -j RETURN >/dev/null 2>&1; then
      insert_position="$("$binary" -w 10 -S DOCKER-USER | awk '
        $1 == "-A" && $2 == "DOCKER-USER" { count++ }
        END { print count }
      ')"
      "$binary" -w 10 -I DOCKER-USER "$insert_position" \
        -m comment --comment "$comment" -j "$guard"
    else
      "$binary" -w 10 -A DOCKER-USER -m comment --comment "$comment" -j "$guard"
    fi
  fi
  validate_jump_order "$binary" "$guard" "$comment" 0
}

verify_ipv4_rules() {
  local count
  count="$(iptables -w 10 -S "$IPV4_CHAIN" | wc -l)"
  [[ "$count" == 9 ]] || die "unexpected IPv4 guard rule count: $count"
  iptables -w 10 -C "$IPV4_CHAIN" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  iptables -w 10 -C "$IPV4_CHAIN" '!' -i "$PUBLIC_INTERFACE" -j RETURN
  iptables -w 10 -C "$IPV4_CHAIN" -i "$PUBLIC_INTERFACE" -p tcp \
    -m conntrack --ctstate NEW --ctorigdst "$PUBLIC_IPV4" --ctorigdstport 2222 \
    --ctdir ORIGINAL -m hashlimit --hashlimit-upto 30/minute --hashlimit-burst 20 \
    --hashlimit-mode srcip --hashlimit-name gitea_ssh_v4 \
    --hashlimit-htable-expire 60000 -j ACCEPT
  iptables -w 10 -C "$IPV4_CHAIN" -i "$PUBLIC_INTERFACE" -p tcp \
    -m conntrack --ctstate NEW --ctorigdst "$PUBLIC_IPV4" --ctorigdstport 2222 \
    --ctdir ORIGINAL -j DROP
  for port in 80 443; do
    iptables -w 10 -C "$IPV4_CHAIN" -i "$PUBLIC_INTERFACE" -p tcp \
      -m conntrack --ctstate NEW --ctorigdst "$PUBLIC_IPV4" \
      --ctorigdstport "$port" --ctdir ORIGINAL -j ACCEPT
  done
  iptables -w 10 -C "$IPV4_CHAIN" -i "$PUBLIC_INTERFACE" -j DROP
  iptables -w 10 -C "$IPV4_CHAIN" -j RETURN
}

verify_ipv6_rules() {
  local count
  count="$(ip6tables -w 10 -S "$IPV6_CHAIN" | wc -l)"
  [[ "$count" == 5 ]] || die "unexpected IPv6 guard rule count: $count"
  ip6tables -w 10 -C "$IPV6_CHAIN" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  ip6tables -w 10 -C "$IPV6_CHAIN" '!' -i "$PUBLIC_INTERFACE" -j RETURN
  ip6tables -w 10 -C "$IPV6_CHAIN" -i "$PUBLIC_INTERFACE" -j DROP
  ip6tables -w 10 -C "$IPV6_CHAIN" -j RETURN
}

verify_all() {
  validate_guard_references iptables "$IPV4_CHAIN" "$IPV4_COMMENT"
  validate_guard_references ip6tables "$IPV6_CHAIN" "$IPV6_COMMENT"
  validate_jump_order iptables "$IPV4_CHAIN" "$IPV4_COMMENT" 0
  validate_jump_order ip6tables "$IPV6_CHAIN" "$IPV6_COMMENT" 0
  verify_ipv4_rules
  verify_ipv6_rules
}

apply_all() {
  validate_guard_references iptables "$IPV4_CHAIN" "$IPV4_COMMENT"
  validate_guard_references ip6tables "$IPV6_CHAIN" "$IPV6_COMMENT"
  validate_jump_order iptables "$IPV4_CHAIN" "$IPV4_COMMENT" 1
  validate_jump_order ip6tables "$IPV6_CHAIN" "$IPV6_COMMENT" 1
  render_ipv4_restore | iptables-restore -w 10 --noflush --test
  render_ipv6_restore | ip6tables-restore -w 10 --noflush --test
  ROLLBACK_DIR="$(mktemp -d /run/lock/gitea-netcup-firewall.XXXXXXXX)"
  chmod 0700 "$ROLLBACK_DIR"
  snapshot_family iptables "$IPV4_CHAIN" "$IPV4_COMMENT" "$ROLLBACK_DIR/ipv4"
  snapshot_family ip6tables "$IPV6_CHAIN" "$IPV6_COMMENT" "$ROLLBACK_DIR/ipv6"
  ROLLBACK_ACTIVE=1
  render_ipv4_restore | iptables-restore -w 10 --noflush
  inject_test_fault after-ipv4
  render_ipv6_restore | ip6tables-restore -w 10 --noflush
  inject_test_fault after-ipv6
  ensure_jump iptables "$IPV4_CHAIN" "$IPV4_COMMENT"
  inject_test_fault after-ipv4-jump
  ensure_jump ip6tables "$IPV6_CHAIN" "$IPV6_COMMENT"
  verify_all
  ROLLBACK_ACTIVE=0
}

[[ $# == 1 ]] || usage
require_runtime
validate_test_fault
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
exec 9>"$LOCK_FILE"
flock -w 30 9 || die 'timed out waiting for the firewall lock'

case "$1" in
  apply) apply_all ;;
  verify) verify_all ;;
  *) usage ;;
esac
