[Unit]
Description=Gitea Netcup DOCKER-USER firewall guard
Wants=network-online.target fail2ban.service
After=network-online.target ufw.service docker.service fail2ban.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStartPre=/usr/bin/sha256sum --check --quiet /etc/gitea/netcup-host-controls.sha256
ExecStart=/usr/local/sbin/gitea-netcup-firewall apply
ExecStartPost=/usr/bin/fail2ban-client reload
ExecStartPost=/usr/local/sbin/gitea-netcup-firewall verify
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/lock
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target docker.service
