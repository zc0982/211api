[Unit]
Description=Create a validated encrypted Gitea platform backup
After=docker.service network-online.target time-sync.target
Wants=network-online.target time-sync.target
Requires=docker.service
OnFailure=gitea-backup-notify@%N.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/gitea/platform.env
ExecStart=/opt/gitea/platform/gitea-backup --daily
UMask=0077
RuntimeDirectory=gitea-backup
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/opt/gitea/backups /run/lock /run/gitea-backup
TimeoutStartSec=3h

[Install]
WantedBy=multi-user.target
