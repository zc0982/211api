age_encrypt() {
  age --encrypt --recipient "$BACKUP_AGE_RECIPIENT"
}

stream_component() {
  local name=$1 producer=$2 validator=$3
  local validate_fifo encrypt_fifo listing output
  local validator_pid age_pid producer_status tee_status validator_status age_status
  local ciphertext_hash listing_hash size
  local -a pipeline_status

  validate_fifo="$SET_PARTIAL/.${name}.validate.fifo"
  encrypt_fifo="$SET_PARTIAL/.${name}.encrypt.fifo"
  listing="$SET_PARTIAL/.${name}.listing"
  output="$SET_PARTIAL/${name}.age.partial"
  mkfifo -m 0600 "$validate_fifo" "$encrypt_fifo"

  "$validator" <"$validate_fifo" >"$listing" &
  validator_pid=$!
  age_encrypt <"$encrypt_fifo" >"$output" &
  age_pid=$!

  set +e
  "$producer" | tee "$validate_fifo" >"$encrypt_fifo"
  pipeline_status=("${PIPESTATUS[@]}")
  producer_status=${pipeline_status[0]}
  tee_status=${pipeline_status[1]}
  wait "$validator_pid"
  validator_status=$?
  wait "$age_pid"
  age_status=$?
  set -e
  rm -f -- "$validate_fifo" "$encrypt_fifo"

  if ((producer_status != 0 || tee_status != 0 || validator_status != 0 || age_status != 0)); then
    FAILURE_CODE=component-validation
    return 1
  fi
  [[ -s "$output" ]] || {
    FAILURE_CODE=component-empty
    return 1
  }
  fsync_path "$output" || {
    FAILURE_CODE=fsync
    return 1
  }
  ciphertext_hash="$(sha256sum "$output" | awk '{print $1}')"
  listing_hash="$(sha256sum "$listing" | awk '{print $1}')"
  size="$(stat -c '%s' "$output")"
  jq -nc \
    --arg name "${name}.age" \
    --arg sha256 "$ciphertext_hash" \
    --arg listing_sha256 "$listing_hash" \
    --argjson size "$size" \
    '{name:$name,sha256:$sha256,listing_sha256:$listing_sha256,size:$size}' \
    >>"$COMPONENT_RECORDS"
  rm -f -- "$listing"
}

build_host_file_list() {
  local path relative
  HOST_FILE_LIST="$SET_PARTIAL/.host-files"
  : >"$HOST_FILE_LIST"
  local -a paths=(
    "$IMAGE_LOCK"
    "$PLATFORM_ROOT"
    "$PLATFORM_ENV"
    "$NOTIFY_URL_FILE"
    "$GITEA_DB_PASSWORD_FILE"
    "$GITEA_SECRET_KEY_FILE"
    "$GITEA_INTERNAL_TOKEN_FILE"
  )
  if [[ -e "$RUNNER_ROOT" ]]; then
    paths+=("$RUNNER_ROOT")
  fi
  local -a optional_admin_paths=(
    "$ADMIN_ROOT"
    /etc/gitea/bootstrap.env
    /etc/gitea/admin-api.curl
    /etc/gitea/admin-api.metadata.json
    /etc/gitea/bootstrap-credentials
    /etc/gitea/tokens
    /etc/gitea/token-metadata
    /etc/gitea/release-tag-ssh-only.json
    /etc/gitea/required-status-contexts
  )
  for path in "${optional_admin_paths[@]}"; do
    [[ ! -L "$path" ]] || die "unsafe admin backup symlink: $path" host-path
    if [[ -e "$path" ]]; then
      validate_optional_admin_backup_path "$path" ||
        die "unsafe admin backup owner, mode, or entry: $path" host-path
      paths+=("$path")
    fi
  done
  paths+=("$GITEA_BACKUP_API_CONFIG")
  for path in "${paths[@]}"; do
    [[ "$path" == /* && -e "$path" && ! -L "$path" ]] ||
      die "unsafe or missing host backup path: $path" host-path
    relative="${path#/}"
    [[ "$relative" != *$'\n'* && "$relative" != ../* && "$relative" != */../* ]] ||
      die "unsafe host backup path" host-path
    printf '%s\n' "$relative" >>"$HOST_FILE_LIST"
  done
}

stop_runner_dispatch() {
  local state
  state="$(runner_state)"
  if [[ "$state" == running ]]; then
    RUNNER_WAS_RUNNING=1
    runner_compose stop -t 30 runner
  fi
  [[ "$(active_action_count)" == 0 ]] ||
    die "an Action started while runner dispatch was stopping" actions-race
}

quiesce_platform() {
  SERVICES_QUIESCED=1
  platform_compose stop -t 30 caddy
  platform_compose stop -t 60 gitea
  platform_compose ps --status running --services | grep -qx postgres
}

verify_api_snapshots_unchanged() {
  local name producer validator expected actual count
  while read -r name producer validator; do
    count="$(jq -s --arg name "$name" '[.[] | select(.name == $name)] | length' "$COMPONENT_RECORDS")"
    [[ "$count" == 1 ]] || die "snapshot component record is missing or duplicated" snapshot-record
    expected="$(jq -sr --arg name "$name" '.[] | select(.name == $name) | .listing_sha256' \
      "$COMPONENT_RECORDS")"
    actual="$("$producer" | "$validator" | sha256sum | awk '{print $1}')" ||
      die "post-backup API snapshot verification failed" snapshot-api
    [[ "$actual" == "$expected" ]] ||
      die "release or package state changed during backup" snapshot-race
  done <<'EOF'
releases.json.age produce_releases validate_release_array
packages.json.age produce_packages validate_package_array
EOF
}

capture_wal() {
  platform_compose exec -T postgres \
    psql -U gitea -d gitea -Atqc 'SELECT pg_current_wal_lsn()'
}

write_manifest_and_promote() {
  local completed_at validated_dir recipient_id components_json manifest_partial file final
  completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  recipient_id="$(printf '%s' "$BACKUP_AGE_RECIPIENT" | sha256sum | awk '{print $1}')"
  components_json="$(jq -s '.' "$COMPONENT_RECORDS")"
  manifest_partial="$SET_PARTIAL/manifest.json.partial"

  jq -n \
    --arg schema gitea-platform-backup.v1 \
    --arg backup_id "$BACKUP_ID" \
    --arg role "$BACKUP_MODE" \
    --arg started_at "$BACKUP_STARTED_AT" \
    --arg completed_at "$completed_at" \
    --arg validated_at "$completed_at" \
    --arg wal_start "$WAL_START" \
    --arg wal_end "$WAL_END" \
    --arg recipient_id "$recipient_id" \
    --arg platform_project gitea-platform \
    --arg runner_project gitea-runner \
    --argjson components "$components_json" \
    '{
      schema:$schema,
      backup_id:$backup_id,
      role:$role,
      started_at:$started_at,
      completed_at:$completed_at,
      validated_at:$validated_at,
      lease_until:null,
      referenced_by:[],
      wal:{start:$wal_start,end:$wal_end},
      age_recipient_id:$recipient_id,
      sources:{platform_project:$platform_project,runner_project:$runner_project},
      components:$components
    }' >"$manifest_partial"
  chmod 0600 "$manifest_partial"
  fsync_path "$manifest_partial" || {
    FAILURE_CODE=fsync
    return 1
  }

  while IFS= read -r -d '' file; do
    final="${file%.partial}"
    mv "$file" "$final"
  done < <(find "$SET_PARTIAL" -mindepth 1 -maxdepth 1 -type f -name '*.age.partial' -print0)
  mv "$manifest_partial" "$SET_PARTIAL/manifest.json"
  rm -f -- "$COMPONENT_RECORDS" "$HOST_FILE_LIST"
  fsync_path "$SET_PARTIAL" || {
    FAILURE_CODE=fsync
    return 1
  }
  validated_dir="$BACKUP_ROOT/$BACKUP_ID.validated"
  [[ ! -e "$validated_dir" && ! -L "$validated_dir" ]]
  PROMOTED_UNSYNCED="$validated_dir"
  mv "$SET_PARTIAL" "$validated_dir"
  SET_PARTIAL=
  fsync_path "$BACKUP_ROOT" || {
    FAILURE_CODE=fsync
    return 1
  }
  VALIDATED_SET="$validated_dir"
  PROMOTED_UNSYNCED=
}

rotate_validated_sets() {
  python3 "$RETENTION_PROGRAM" --root "$BACKUP_ROOT" --dry-run
  python3 "$RETENTION_PROGRAM" --root "$BACKUP_ROOT" --apply
}

load_configuration() {
  require_root_file "$PLATFORM_ENV"
  require_root_file "$NOTIFY_URL_FILE"
  require_root_nonsecret_file "$IMAGE_LOCK"
  require_root_nonsecret_file "$PLATFORM_COMPOSE_FILE"
  require_root_nonsecret_file "$RETENTION_PROGRAM"
  require_root_nonsecret_file "$STRICT_ENV_LOADER"
  require_root_nonsecret_file "$TAR_VALIDATOR"
  # shellcheck source=strict-env.sh
  source "$STRICT_ENV_LOADER"
  gitea_load_platform_env "$PLATFORM_ENV" || die "platform environment schema check failed" config-format
  gitea_load_image_lock "$IMAGE_LOCK" || die "image lock schema check failed" config-format
  require_root_file "$GITEA_DB_PASSWORD_FILE"
  require_root_file "$GITEA_SECRET_KEY_FILE"
  require_root_file "$GITEA_INTERNAL_TOKEN_FILE"
}

preflight() {
  local command_name state
  for command_name in age curl docker flock jq openssl python3 sha256sum tar tee timedatectl; do
    require_command "$command_name"
  done
  [[ -f "$IMAGE_LOCK" && -f "$PLATFORM_COMPOSE_FILE" && -x "$RETENTION_PROGRAM" ]]
  state="$(runner_state)"
  if [[ "$state" != absent ]]; then
    require_root_nonsecret_file "$RUNNER_COMPOSE_FILE"
  fi
  platform_compose config --quiet
  check_ntp
  check_tls_and_health
  probe_webhook
  wait_for_actions_idle
  check_disk_capacity
}

create_backup_set() {
  local timestamp suffix volume key
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  suffix="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  BACKUP_ID="gitea-${timestamp}-${suffix}"
  BACKUP_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  SET_PARTIAL="$BACKUP_ROOT/$BACKUP_ID.partial"
  mkdir -m 0700 "$SET_PARTIAL"
  COMPONENT_RECORDS="$SET_PARTIAL/.components.jsonl"
  : >"$COMPONENT_RECORDS"
  chmod 0600 "$COMPONENT_RECORDS"

  stop_runner_dispatch
  stream_component releases.json produce_releases validate_release_array
  stream_component packages.json produce_packages validate_package_array
  quiesce_platform
  WAL_START="$(capture_wal)"
  [[ -n "$WAL_START" ]]

  stream_component postgres.dump produce_database validate_database
  stream_component refs.inventory produce_refs validate_refs

  for key in gitea-data gitea-config caddy-data caddy-config; do
    case "$key" in
      gitea-data) CURRENT_VOLUME=gitea-platform-gitea-data ;;
      gitea-config) CURRENT_VOLUME=gitea-platform-gitea-config ;;
      caddy-data) CURRENT_VOLUME=gitea-platform-caddy-data ;;
      caddy-config) CURRENT_VOLUME=gitea-platform-caddy-config ;;
    esac
    stream_component "volume-${key}.tar" produce_volume validate_volume_tar
  done
  if docker volume inspect "$RUNNER_DATA_VOLUME" >/dev/null 2>&1; then
    CURRENT_VOLUME="$RUNNER_DATA_VOLUME"
    stream_component volume-runner-data.tar produce_volume validate_volume_tar
  fi

  build_host_file_list
  stream_component host-config.tar produce_host_config validate_host_tar
  WAL_END="$(capture_wal)"
  [[ -n "$WAL_END" ]]
}

main() {
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
  umask 077
  [[ "$EUID" -eq 0 ]] || {
    printf 'gitea-backup must run as root.\n' >&2
    exit 77
  }
  if env | grep -q '^GITEA_BACKUP_TEST_'; then
    printf 'test-only backup controls are forbidden in production.\n' >&2
    exit 64
  fi
  case "${1:-}" in
    ""|--daily) BACKUP_MODE=daily ;;
    --bootstrap) BACKUP_MODE=bootstrap ;;
    --upgrade) BACKUP_MODE=upgrade-predecessor ;;
    *) printf 'Usage: gitea-backup [--daily|--bootstrap|--upgrade]\n' >&2; exit 64 ;;
  esac

  [[ ! -L "$BACKUP_ROOT" && ! -L "$RUNTIME_DIR" && ! -L "$BACKUP_LOCK" ]] || {
    printf 'backup state paths must not be symbolic links.\n' >&2
    exit 73
  }
  mkdir -p "$BACKUP_ROOT" "$(dirname -- "$BACKUP_LOCK")" "$RUNTIME_DIR"
  chmod 0700 "$BACKUP_ROOT" "$RUNTIME_DIR"
  [[ "$(stat -c '%u:%a' "$BACKUP_ROOT")" == 0:700 ]]
  [[ "$(stat -c '%u:%a' "$RUNTIME_DIR")" == 0:700 ]]
  if [[ -e "$BACKUP_LOCK" ]]; then
    [[ -f "$BACKUP_LOCK" && ! -L "$BACKUP_LOCK" && "$(stat -c '%u' "$BACKUP_LOCK")" == 0 ]]
  fi
  exec 9>"$BACKUP_LOCK"
  flock -n 9 || exit 75
  trap finalize EXIT
  trap 'on_signal 129' HUP
  trap 'on_signal 130' INT
  trap 'on_signal 143' TERM

  load_configuration
  cleanup_stale_partials
  preflight
  create_backup_set
  restore_services || {
    FAILURE_CODE=service-restore
    return 1
  }
  verify_api_snapshots_unchanged
  write_manifest_and_promote
  rotate_validated_sets
  log "Validated backup created: $BACKUP_ID"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
