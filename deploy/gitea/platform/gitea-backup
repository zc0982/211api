#!/usr/bin/env bash

set -euo pipefail

readonly PLATFORM_ROOT=/opt/gitea/platform
readonly RUNNER_ROOT=/opt/gitea/runner
readonly ADMIN_ROOT=/opt/gitea/admin
readonly IMAGE_LOCK=/opt/gitea/images.lock.env
readonly PLATFORM_ENV=/etc/gitea/platform.env
readonly PLATFORM_COMPOSE_FILE=/opt/gitea/platform/compose.yaml
readonly RUNNER_COMPOSE_FILE=/opt/gitea/runner/compose.yaml
readonly BACKUP_ROOT=/opt/gitea/backups
readonly BACKUP_LOCK=/run/lock/gitea-platform-backup.lock
readonly RUNTIME_DIR=/run/gitea-backup
readonly FAILURE_MARKER=/opt/gitea/backups/FAILED
readonly NOTIFY_URL_FILE=/etc/gitea/backup-notify-url
readonly RETENTION_PROGRAM=/opt/gitea/platform/gitea_backup_retention.py
readonly STRICT_ENV_LOADER=/opt/gitea/platform/strict-env.sh
readonly TAR_VALIDATOR=/opt/gitea/platform/gitea_validate_tar.py
