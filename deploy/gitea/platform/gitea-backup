FAILURE_CODE=unexpected
SET_PARTIAL=
VALIDATED_SET=
PROMOTED_UNSYNCED=
PREFLIGHT_CERT=
WEBHOOK_CONFIG=
WEBHOOK_PAYLOAD=
SERVICES_QUIESCED=0
RUNNER_WAS_RUNNING=0
FINALIZED=0
COMPONENT_RECORDS=
BACKUP_MODE=daily
BACKUP_ID=
BACKUP_STARTED_AT=
WAL_START=
WAL_END=

log() {
  printf '%s\n' "$*"
}

die() {
  FAILURE_CODE=${2:-preflight}
  printf 'gitea-backup: %s\n' "$1" >&2
  return 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1" command-missing
}

require_root_file() {
  local path=$1
  local mode owner
  [[ -f "$path" && ! -L "$path" ]] || die "required root file is missing: $path" config-missing
  owner="$(stat -c '%u' "$path")"
  mode="$(stat -c '%a' "$path")"
  [[ "$owner" == 0 && "$mode" == 600 ]] ||
    die "required root file must be root-owned mode 0600: $path" config-permissions
}

require_root_nonsecret_file() {
  local path=$1 mode
  [[ -f "$path" && ! -L "$path" ]] || die "required host file is missing: $path" config-missing
  [[ "$(stat -c '%u' "$path")" == 0 ]] || die "required host file is not root-owned: $path" config-permissions
  mode="$(stat -c '%a' "$path")"
  [[ "$mode" == 600 || "$mode" == 644 || "$mode" == 755 ]] ||
    die "required host file has an unsafe mode: $path" config-permissions
}

fsync_path() {
  local path=$1
  if [[ "${GITEA_BACKUP_TEST_FAIL_FSYNC:-0}" == 1 ]]; then
    return 1
  fi
  python3 -c '
import os, sys
path = sys.argv[1]
flags = os.O_RDONLY
if os.path.isdir(path):
    flags |= os.O_DIRECTORY
fd = os.open(path, flags)
try:
    os.fsync(fd)
finally:
    os.close(fd)
' "$path"
}

platform_compose() {
  docker compose \
    --env-file "$IMAGE_LOCK" \
    --env-file "$PLATFORM_ENV" \
    -f "$PLATFORM_COMPOSE_FILE" \
    "$@"
}

runner_compose() {
  docker compose \
    --env-file "$IMAGE_LOCK" \
    -f "$RUNNER_COMPOSE_FILE" \
    "$@"
}

runner_state() {
  local states
  states="$(docker ps -a \
    --filter label=com.docker.compose.project=gitea-runner \
    --filter label=com.docker.compose.service=runner \
    --format '{{.State}}')"
  if [[ -z "$states" ]]; then
    printf 'absent\n'
    return
  fi
  [[ "$(wc -l <<<"$states")" -eq 1 ]] || die "multiple runner service containers found" runner-state
  printf '%s\n' "$states"
}

write_failure_marker() {
  local code=$1
  local failed_at tmp
  failed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tmp="${FAILURE_MARKER}.partial.$$"
  jq -n \
    --arg schema gitea-backup-failure.v1 \
    --arg event backup-failed \
    --arg status failed \
    --arg failed_at "$failed_at" \
    --arg code "$code" \
    '{schema:$schema,event:$event,status:$status,failed_at:$failed_at,code:$code}' \
    >"$tmp"
  chmod 0600 "$tmp"
  fsync_path "$tmp"
  mv -f "$tmp" "$FAILURE_MARKER"
  fsync_path "$BACKUP_ROOT"
}

remove_owned_partial_at() {
  local partial=$1 root=$2
  if [[ -n "$partial" && -d "$partial" && ! -L "$partial" ]]; then
    case "$partial" in
      "$root"/gitea-????????T??????Z-????????.partial)
        rm -rf -- "$partial"
        ;;
    esac
  fi
}

remove_owned_partial() {
  remove_owned_partial_at "$SET_PARTIAL" "$BACKUP_ROOT"
  if [[ -n "$PROMOTED_UNSYNCED" && -d "$PROMOTED_UNSYNCED" && ! -L "$PROMOTED_UNSYNCED" ]]; then
    case "$PROMOTED_UNSYNCED" in
      "$BACKUP_ROOT"/gitea-????????T??????Z-????????.validated)
        rm -rf -- "$PROMOTED_UNSYNCED"
        ;;
    esac
  fi
  if [[ -n "$PREFLIGHT_CERT" ]]; then
    rm -f -- "$PREFLIGHT_CERT"
  fi
  [[ -z "$WEBHOOK_CONFIG" ]] || rm -f -- "$WEBHOOK_CONFIG"
  [[ -z "$WEBHOOK_PAYLOAD" ]] || rm -f -- "$WEBHOOK_PAYLOAD"
}

wait_platform_health() {
  local attempt
  for attempt in $(seq 1 60); do
    if platform_compose ps --status running postgres gitea caddy >/dev/null 2>&1 &&
      curl --silent --show-error --fail --connect-timeout 3 --max-time 5 \
        "$GITEA_HEALTH" >/dev/null; then
      return 0
    fi
    sleep 5
  done
  return 1
}

restore_services() {
  local status=0 platform_status=0 runner_status=0
  if ((SERVICES_QUIESCED)); then
    platform_compose up -d secret-init postgres gitea caddy || platform_status=1
    wait_platform_health || platform_status=1
    if ((platform_status == 0)); then
      SERVICES_QUIESCED=0
    else
      status=1
    fi
  fi
  if ((RUNNER_WAS_RUNNING)); then
    runner_compose up -d docker runner || runner_status=1
    for _ in $(seq 1 30); do
      if runner_compose ps --status running --services 2>/dev/null | grep -qx runner; then
        break
      fi
      sleep 2
    done
    runner_compose ps --status running --services 2>/dev/null | grep -qx runner || runner_status=1
    if ((runner_status == 0)); then
      RUNNER_WAS_RUNNING=0
    else
      status=1
    fi
  fi
  return "$status"
}

finalize() {
  local status=$?
  local restore_status=0
  if ((FINALIZED)); then
    return
  fi
  FINALIZED=1
  trap - EXIT HUP INT TERM
  set +e
  remove_owned_partial
  restore_services
  restore_status=$?
  if ((restore_status != 0)); then
    status=1
    FAILURE_CODE=service-restore
  fi
  if ((status == 0)); then
    rm -f -- "$FAILURE_MARKER"
    if ! fsync_path "$BACKUP_ROOT"; then
      status=1
      FAILURE_CODE=fsync
      write_failure_marker "$FAILURE_CODE" || true
    fi
  else
    write_failure_marker "$FAILURE_CODE" || true
  fi
  exit "$status"
}

on_signal() {
  FAILURE_CODE=signal
  exit "$1"
}

parse_offset_microseconds() {
  python3 -c '
import re, sys
match = re.fullmatch(r"([+-]?)([0-9]+(?:\.[0-9]+)?)(ns|us|µs|ms|s)", sys.argv[1])
if not match:
    raise SystemExit(1)
sign = -1 if match.group(1) == "-" else 1
scale = {"ns": 0.001, "us": 1, "µs": 1, "ms": 1000, "s": 1000000}[match.group(3)]
print(round(sign * float(match.group(2)) * scale))
' "$1"
}

check_ntp() {
  local synchronized offset_text offset_us
  synchronized="$(timedatectl show --property=NTPSynchronized --value)"
  [[ "$synchronized" == yes ]] || die "NTP is not synchronized" ntp
  offset_text="$(LC_ALL=C timedatectl timesync-status 2>/dev/null |
    awk -F: '$1 ~ /^[[:space:]]*Offset$/ {gsub(/[[:space:]]/, "", $2); print $2; exit}')"
  [[ -n "$offset_text" ]] || die "NTP offset is unavailable" ntp-offset
  offset_us="$(parse_offset_microseconds "$offset_text")" ||
    die "NTP offset format is unsupported" ntp-offset
  ((offset_us >= -5000000 && offset_us <= 5000000)) ||
    die "NTP offset exceeds five seconds" ntp-offset
}

check_tls_and_health() {
  PREFLIGHT_CERT="$RUNTIME_DIR/certificate.$$.pem"
  openssl s_client \
    -connect git.211api.com:443 \
    -servername git.211api.com \
    -verify_return_error \
    -showcerts </dev/null 2>/dev/null |
    openssl x509 -outform PEM >"$PREFLIGHT_CERT"
  openssl x509 -in "$PREFLIGHT_CERT" -checkend 1209600 -noout >/dev/null
  curl --silent --show-error --fail --connect-timeout 5 --max-time 15 \
    "$GITEA_HEALTH" >/dev/null
}

validate_webhook_url() {
  local url=$1
  [[ "$url" == https://* && "$url" != *[[:space:]]* &&
    "$url" != *\"* && "$url" != *\\* ]] ||
    die "backup notification URL must be one safe HTTPS line" webhook-config
}

read_single_line() {
  local path=$1
  local -a lines=()
  mapfile -t lines <"$path"
  if [[ "${#lines[@]}" -ne 1 ]]; then
    die "configuration must contain exactly one line: $path" config-format
    return 1
  fi
  printf '%s\n' "${lines[0]}"
}

validate_api_config() {
  local path=$1 line
  if ! line="$(read_single_line "$path")"; then
    return 1
  fi
  [[ "$line" =~ ^header[[:space:]]*=[[:space:]]*\"Authorization:[[:space:]]token[[:space:]][0-9A-Za-z_-]{20,256}\"$ ]] ||
    die "backup API curl config must contain only one token header" api-config
}

probe_webhook() {
  local url http_status
  require_root_file "$NOTIFY_URL_FILE"
  url="$(read_single_line "$NOTIFY_URL_FILE")"
  validate_webhook_url "$url"
  WEBHOOK_CONFIG="$RUNTIME_DIR/webhook.$$.curl"
  WEBHOOK_PAYLOAD="$RUNTIME_DIR/webhook.$$.json"
  printf 'url = "%s"\n' "$url" >"$WEBHOOK_CONFIG"
  chmod 0600 "$WEBHOOK_CONFIG"
  jq -n '{schema:"gitea-backup-notification.v1",event:"preflight",status:"ok"}' >"$WEBHOOK_PAYLOAD"
  chmod 0600 "$WEBHOOK_PAYLOAD"
  http_status="$(curl --config "$WEBHOOK_CONFIG" \
    --silent --show-error --fail \
    --connect-timeout 5 --max-time 15 \
    --header 'Content-Type: application/json' \
    --data-binary "@$WEBHOOK_PAYLOAD" \
    --output /dev/null \
    --write-out '%{http_code}')"
  [[ "$http_status" =~ ^2[0-9]{2}$ ]] || die "backup webhook did not return HTTP 2xx" webhook-http
  rm -f -- "$WEBHOOK_CONFIG" "$WEBHOOK_PAYLOAD"
  WEBHOOK_CONFIG=
  WEBHOOK_PAYLOAD=
}

volume_size_kib() {
  local volume=$1
  docker run --rm --read-only --network none \
    -v "$volume:/source:ro" \
    "$APP_ALPINE_IMAGE" \
    sh -ec 'du -sk /source | cut -f1'
}

check_disk_capacity() {
  local volume source_kib=0 latest_kib=0 required_kib available_kib total_kib
  for volume in "${REQUIRED_PLATFORM_VOLUMES[@]}"; do
    docker volume inspect "$volume" >/dev/null
    source_kib=$((source_kib + $(volume_size_kib "$volume")))
  done
  if docker volume inspect "$RUNNER_DATA_VOLUME" >/dev/null 2>&1; then
    source_kib=$((source_kib + $(volume_size_kib "$RUNNER_DATA_VOLUME")))
  fi
  source_kib=$((source_kib + $(du -sk "$PLATFORM_ROOT" | awk '{print $1}')))
  if [[ -d "$RUNNER_ROOT" ]]; then
    source_kib=$((source_kib + $(du -sk "$RUNNER_ROOT" | awk '{print $1}')))
  fi
  while IFS= read -r size; do
    ((size > latest_kib)) && latest_kib=$size
  done < <(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '*.validated' \
    -exec du -sk {} + 2>/dev/null | awk '{print $1}')
  ((source_kib < 1024)) && source_kib=1024
  ((latest_kib > source_kib)) && source_kib=$latest_kib
  read -r total_kib available_kib < <(df -Pk "$BACKUP_ROOT" | awk 'NR == 2 {print $2, $4}')
  assert_disk_capacity "$total_kib" "$available_kib" "$source_kib"
}

assert_disk_capacity() {
  local total_kib=$1 available_kib=$2 estimated_set_kib=$3
  local required_kib=$((estimated_set_kib * 2))
  if ((total_kib <= 0 || available_kib < 0 || estimated_set_kib <= 0)); then
    die "backup filesystem capacity data is invalid" disk-capacity
    return 1
  fi
  if ((available_kib * 100 / total_kib < 20)); then
    die "backup filesystem has less than 20 percent free" disk-capacity
    return 1
  fi
  if ((available_kib < required_kib)); then
    die "backup filesystem lacks room for two estimated sets" disk-capacity
    return 1
  fi
}

api_get() {
  curl --config "$GITEA_BACKUP_API_CONFIG" \
    --silent --show-error --fail \
    --connect-timeout 5 --max-time 20 \
    "$1"
}

active_action_count() {
  local status body count total=0
  for status in pending queued in_progress; do
    body="$(api_get "$GITEA_API/repos/211api/211api/actions/runs?status=$status&limit=1")"
    count="$(jq -er '.total_count | select(type == "number" and . >= 0)' <<<"$body")"
    total=$((total + count))
  done
  printf '%s\n' "$total"
}

wait_for_actions_idle() {
  local active attempt
  [[ -n "${GITEA_BACKUP_API_CONFIG:-}" ]] || {
    die "backup API curl config is required" api-config
    return 1
  }
  require_root_file "$GITEA_BACKUP_API_CONFIG" || return 1
  validate_api_config "$GITEA_BACKUP_API_CONFIG" || return 1

  for attempt in 1 2; do
    active="$(active_action_count)" || die "Actions API check failed" actions-api
    if ((active == 0)); then
      return 0
    fi
    if ((attempt == 1)); then
      log "Actions are active; postponing once for 300 seconds."
      sleep 300
    fi
  done
  die "Actions remained active after one postponement" actions-active
}

cleanup_stale_partials_at() {
  local root=$1 candidate
  [[ -d "$root" && ! -L "$root" ]] || die "unsafe backup root" backup-root
  while IFS= read -r -d '' candidate; do
    [[ ! -L "$candidate" && "$(dirname -- "$candidate")" == "$root" ]] || continue
    rm -rf -- "$candidate"
  done < <(find "$root" -mindepth 1 -maxdepth 1 -type d \
    -name 'gitea-????????T??????Z-????????.partial' -mmin +1440 -print0)
}

cleanup_stale_partials() {
  cleanup_stale_partials_at "$BACKUP_ROOT"
}

produce_paginated_array() {
  local endpoint=$1
  local page=1 body length first=1 separator
  printf '['
  while ((page <= 1000)); do
    [[ "$endpoint" == *\?* ]] && separator='&' || separator='?'
    body="$(api_get "${endpoint}${separator}page=$page&limit=50")"
    jq -e 'type == "array"' <<<"$body" >/dev/null
    length="$(jq -r 'length' <<<"$body")"
    while IFS= read -r item; do
      ((first)) || printf ','
      first=0
      printf '%s' "$item"
    done < <(jq -c '.[]' <<<"$body")
    ((length < 50)) && break
    page=$((page + 1))
  done
  ((page <= 1000)) || return 1
  printf ']\n'
}

produce_releases() {
  produce_paginated_array "$GITEA_API/repos/211api/211api/releases"
}

produce_packages() {
  produce_paginated_array "$GITEA_API/packages/211api?type=container"
}

validate_release_array() {
  jq -S -e '
    if type == "array" and all(.[];
      (.tag_name | type == "string")
      and (.target_commitish | type == "string")
      and (.name | type == "string")
      and (.draft | type == "boolean")
      and (.prerelease | type == "boolean"))
    then map({tag_name,target_commitish,name,draft,prerelease}) | sort_by(.tag_name)
    else error("invalid release array") end
  ' -
}

validate_package_array() {
  jq -S -e '
    if type == "array" and all(.[];
      (.type | type == "string")
      and (.name | type == "string")
      and (.version | type == "string"))
    then map({type,name,version}) | sort_by(.type,.name,.version)
    else error("invalid package array") end
  ' -
}

produce_database() {
  platform_compose exec -T postgres \
    pg_dump -U gitea -d gitea -Fc --no-owner --no-privileges
}

validate_database() {
  local validator_dir fifo listing restore_pid
  local tee_status restore_status

  validator_dir="$SET_PARTIAL/.postgres-validator.$$"
  fifo="$validator_dir/dump.fifo"
  listing="$validator_dir/listing"
  mkdir -m 0700 -- "$validator_dir"
  mkfifo -m 0600 "$fifo"

  platform_compose exec -T postgres pg_restore --list <"$fifo" >"$listing" &
  restore_pid=$!

  # pg_restore can finish after reading the custom archive directory instead of
  # consuming the complete stream. Keep draining stdin after that FIFO closes so
  # pg_dump and the parallel age encryption branch never receive SIGPIPE.
  if tee --output-error=warn-nopipe "$fifo" >/dev/null; then
    tee_status=0
  else
    tee_status=$?
  fi
  if wait "$restore_pid"; then
    restore_status=0
  else
    restore_status=$?
  fi

  rm -f -- "$fifo"
  if ((tee_status != 0 || restore_status != 0)); then
    rm -rf -- "$validator_dir"
    return 1
  fi
  cat "$listing"
  rm -rf -- "$validator_dir"
}

