readonly GITEA_HEALTH=https://git.211api.com/api/healthz
readonly -a REQUIRED_PLATFORM_VOLUMES=(
  gitea-platform-postgres-data
  gitea-platform-gitea-data
  gitea-platform-gitea-config
  gitea-platform-runtime-secrets
  gitea-platform-caddy-data
  gitea-platform-caddy-config
)
