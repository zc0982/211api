validate_optional_admin_backup_path() {
  local path=$1 entry metadata
  case "$path" in
    "$ADMIN_ROOT")
      [[ -d "$path" && ! -L "$path" ]] || return 1
      [[ "$(stat -c '%u:%g %a' "$path")" == '0:0 755' ]] || return 1
      while IFS= read -r -d '' entry; do
        [[ ! -L "$entry" ]] || return 1
        if [[ -d "$entry" ]]; then
          metadata=$(stat -c '%u:%g %a' "$entry")
          [[ "$metadata" == '0:0 755' ]] || return 1
        elif [[ -f "$entry" ]]; then
          metadata=$(stat -c '%u:%g %a' "$entry")
          [[ "$metadata" == '0:0 644' || "$metadata" == '0:0 755' ]] || return 1
        else
          return 1
        fi
      done < <(find "$path" -xdev -mindepth 1 -print0)
      ;;
    /etc/gitea/bootstrap-credentials|/etc/gitea/tokens|/etc/gitea/token-metadata)
      [[ -d "$path" && ! -L "$path" ]] || return 1
      [[ "$(stat -c '%u:%g %a' "$path")" == '0:0 700' ]] || return 1
      while IFS= read -r -d '' entry; do
        [[ -f "$entry" && ! -L "$entry" ]] || return 1
        [[ "$(stat -c '%u:%g %a' "$entry")" == '0:0 600' ]] || return 1
      done < <(find "$path" -xdev -mindepth 1 -maxdepth 1 -print0)
      [[ -z "$(find "$path" -xdev -mindepth 2 -print -quit)" ]] || return 1
      ;;
    /etc/gitea/bootstrap.env|/etc/gitea/admin-api.curl|/etc/gitea/admin-api.metadata.json|/etc/gitea/release-tag-ssh-only.json|/etc/gitea/required-status-contexts)
      [[ -f "$path" && ! -L "$path" ]] || return 1
      [[ "$(stat -c '%u:%g %a' "$path")" == '0:0 600' ]] || return 1
      ;;
    *) return 1 ;;
  esac
}

produce_refs() {
  docker run --rm --read-only --network none --user 1000:1000 \
    --entrypoint /bin/sh \
    -v gitea-platform-gitea-data:/var/lib/gitea:ro \
    "$GITEA_IMAGE" \
    -ec 'git --git-dir=/var/lib/gitea/git/repositories/211api/211api.git for-each-ref --format="%(objectname) %(refname)" refs/heads refs/tags | LC_ALL=C sort'
}

validate_refs() {
  awk '
    NF == 0 { next }
    NF != 2 || $1 !~ /^[0-9a-f]{40}$/ || $2 !~ /^refs\// { exit 1 }
    { print }
  '
