#!/usr/bin/env bash

set -euo pipefail

readonly FAILURE_MARKER=/opt/gitea/backups/FAILED
readonly NOTIFY_URL_FILE=/etc/gitea/backup-notify-url
readonly RUNTIME_DIR=/run/gitea-backup

URL_CONFIG=
PAYLOAD=

cleanup() {
  [[ -z "$URL_CONFIG" ]] || rm -f -- "$URL_CONFIG"
  [[ -z "$PAYLOAD" ]] || rm -f -- "$PAYLOAD"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

require_root_file() {
  local path=$1
  [[ -f "$path" && ! -L "$path" ]]
  [[ "$(stat -c '%u:%a' "$path")" == 0:600 ]]
}

read_single_line() {
  local path=$1
  local -a lines=()
  mapfile -t lines <"$path"
  [[ "${#lines[@]}" -eq 1 ]] || return 1
  printf '%s\n' "${lines[0]}"
}

main() {
  local unit=unknown url schema event status failed_at code http_status
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
  umask 077
  [[ "$EUID" -eq 0 ]] || exit 77
  [[ ! -L "$RUNTIME_DIR" ]]
  install -d -o root -g root -m 0700 "$RUNTIME_DIR"
  [[ "$(stat -c '%u:%a' "$RUNTIME_DIR")" == 0:700 ]]
  if (($# == 2)) && [[ "$1" == --unit ]]; then
    unit=$2
  elif (($# != 0)); then
    printf 'Usage: gitea-backup-notify [--unit UNIT]\n' >&2
    exit 64
  fi
  [[ "$unit" =~ ^[0-9A-Za-z_.@-]+$ ]]
  require_root_file "$FAILURE_MARKER"
  require_root_file "$NOTIFY_URL_FILE"

  schema="$(jq -er '.schema | select(type == "string")' "$FAILURE_MARKER")"
  event="$(jq -er '.event | select(type == "string")' "$FAILURE_MARKER")"
  status="$(jq -er '.status | select(type == "string")' "$FAILURE_MARKER")"
  failed_at="$(jq -er '.failed_at | select(type == "string")' "$FAILURE_MARKER")"
  code="$(jq -er '.code | select(type == "string")' "$FAILURE_MARKER")"
  [[ "$schema" == gitea-backup-failure.v1 ]]
  [[ "$event" == backup-failed && "$status" == failed ]]
  [[ "$failed_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]
  [[ "$code" =~ ^[a-z0-9-]{1,48}$ ]]

  url="$(read_single_line "$NOTIFY_URL_FILE")"
  [[ "$url" == https://* && "$url" != *[[:space:]]* &&
    "$url" != *\"* && "$url" != *\\* ]]

  URL_CONFIG="$RUNTIME_DIR/notify.$$.curl"
  PAYLOAD="$RUNTIME_DIR/notify.$$.json"
  printf 'url = "%s"\n' "$url" >"$URL_CONFIG"
  jq -n \
    --arg schema gitea-backup-notification.v1 \
    --arg event backup-failed \
    --arg status failed \
    --arg failed_at "$failed_at" \
    --arg code "$code" \
    --arg unit "$unit" \
    '{schema:$schema,event:$event,status:$status,failed_at:$failed_at,code:$code,unit:$unit}' \
    >"$PAYLOAD"
  chmod 0600 "$URL_CONFIG" "$PAYLOAD"
  http_status="$(curl --config "$URL_CONFIG" \
    --silent --show-error --fail \
    --connect-timeout 5 --max-time 15 \
    --header 'Content-Type: application/json' \
    --data-binary "@$PAYLOAD" \
    --output /dev/null \
    --write-out '%{http_code}')"
  [[ "$http_status" =~ ^2[0-9]{2}$ ]]
}

main "$@"
