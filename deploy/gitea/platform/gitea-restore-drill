#!/usr/bin/env bash

set -euo pipefail

readonly BACKUP_ROOT=/opt/gitea/backups
readonly BACKUP_LOCK=/run/lock/gitea-platform-backup.lock
readonly IMAGE_LOCK=/opt/gitea/images.lock.env
readonly RESTORE_COMPOSE_FILE=/opt/gitea/platform/restore-compose.yaml
readonly STRICT_ENV_LOADER=/opt/gitea/platform/strict-env.sh
readonly TAR_VALIDATOR=/opt/gitea/platform/gitea_validate_tar.py
readonly SCRATCH_PARENT=/opt/gitea/restore-drills
readonly -a LIVE_VOLUMES=(
  gitea-platform-postgres-data
  gitea-platform-gitea-data
  gitea-platform-gitea-config
  gitea-platform-runtime-secrets
  gitea-platform-caddy-data
  gitea-platform-caddy-config
  gitea-runner-data
  gitea-runner-docker-data
  gitea-runner-runtime
)

BACKUP_ID=
IDENTITY_SOURCE=
CUSTODY_RECORD=
BACKUP_DIR=
MANIFEST=
RUN_ID=
RESTORE_PROJECT=
RESTORE_HTTP_PORT=
SCRATCH=
KEY_MOUNT=
KEY_COPY=
KEY_MOUNTED=0
LEASED=0
COMPOSE_STARTED=0
RESTORED_API_CONFIG=
RESTORED_PLATFORM_ENV=
RESTORED_IMAGE_LOCK=
LOCAL_API_CONFIG=
LOCAL_REGISTRY_CONFIG=
CREATED_VOLUME=
LEASE_TEMP=
declare -a OWNED_VOLUMES=()

log() {
  printf '%s\n' "$*"
}

die() {
  printf 'gitea-restore-drill: %s\n' "$1" >&2
  return 1
}

fsync_path() {
  python3 -c '
import os, sys
path = sys.argv[1]
flags = os.O_RDONLY | (os.O_DIRECTORY if os.path.isdir(path) else 0)
fd = os.open(path, flags)
try:
    os.fsync(fd)
finally:
    os.close(fd)
' "$1"
}

compose_restore() {
  docker compose \
    --env-file "$RESTORED_IMAGE_LOCK" \
    -f "$RESTORE_COMPOSE_FILE" \
    "$@"
}

safe_remove_scratch() {
  if [[ -n "$SCRATCH" && -d "$SCRATCH" && ! -L "$SCRATCH" ]]; then
    case "$SCRATCH" in
      "$SCRATCH_PARENT"/gitea-restore-[0-9a-f]*) rm -rf -- "$SCRATCH" ;;
    esac
  fi
}

volume_is_live() {
  local candidate=$1 live project
  for live in "${LIVE_VOLUMES[@]}"; do
    [[ "$candidate" != "$live" ]] || return 0
  done
  if docker volume inspect "$candidate" >/dev/null 2>&1; then
    project="$(docker volume inspect \
      --format '{{index .Labels "com.docker.compose.project"}}' "$candidate" 2>/dev/null || true)"
    [[ "$project" == gitea-platform || "$project" == gitea-runner ]] && return 0
  fi
  return 1
}

remove_owned_volume() {
  local volume=$1 label
  docker volume inspect "$volume" >/dev/null 2>&1 || return 0
  volume_is_live "$volume" && return 1
  label="$(docker volume inspect \
    --format '{{index .Labels "com.211api.restore-run"}}' "$volume" 2>/dev/null || true)"
  [[ "$label" == "$RUN_ID" ]] || return 1
  docker volume rm "$volume" >/dev/null
}

release_lease() {
  local tmp
  [[ -f "$MANIFEST" && ! -L "$MANIFEST" ]] || return 1
  if ! jq -e --arg run_id "$RUN_ID" '.referenced_by | index($run_id) != null' \
    "$MANIFEST" >/dev/null; then
    LEASED=0
    return 0
  fi
  tmp="${MANIFEST}.lease-partial.$$"
  LEASE_TEMP=$tmp
  jq --arg run_id "$RUN_ID" '
    .referenced_by = [.referenced_by[] | select(. != $run_id)]
  ' "$MANIFEST" >"$tmp"
  chmod 0600 "$tmp"
  fsync_path "$tmp"
  mv -f "$tmp" "$MANIFEST"
  LEASE_TEMP=
  fsync_path "$BACKUP_DIR"
  LEASED=0
}

cleanup() {
  local status=$?
  local volume
  trap - EXIT HUP INT TERM
  set +e
  if ((COMPOSE_STARTED)); then
    compose_restore down --remove-orphans --timeout 30 >/dev/null 2>&1 || status=1
  fi
  for volume in "${OWNED_VOLUMES[@]}"; do
    remove_owned_volume "$volume" || status=1
  done
  release_lease || status=1
  [[ -z "$LEASE_TEMP" ]] || rm -f -- "$LEASE_TEMP"
  safe_remove_scratch
  if ((KEY_MOUNTED)); then
    umount "$KEY_MOUNT" || status=1
    KEY_MOUNTED=0
  fi
  [[ -z "$KEY_MOUNT" ]] || rmdir "$KEY_MOUNT" 2>/dev/null || status=1
  exit "$status"
}

on_signal() {
  exit "$1"
}

parse_args() {
  while (($#)); do
    case "$1" in
      --backup-id)
        (($# >= 2)) || die "--backup-id requires a value"
        BACKUP_ID=$2
        shift 2
        ;;
      --identity)
        (($# >= 2)) || die "--identity requires a value"
        IDENTITY_SOURCE=$2
        shift 2
        ;;
      --custody-record)
        (($# >= 2)) || die "--custody-record requires a value"
        CUSTODY_RECORD=$2
        shift 2
        ;;
      *)
        die "Usage: gitea-restore-drill --backup-id ID --identity TMPFS_KEY --custody-record FILE"
        ;;
    esac
  done
  [[ "$BACKUP_ID" =~ ^gitea-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$ ]]
  [[ "$IDENTITY_SOURCE" == /* && "$CUSTODY_RECORD" == /* ]]
}

require_root_file() {
  local path=$1
  [[ -f "$path" && ! -L "$path" ]]
  [[ "$(stat -c '%u:%a' "$path")" == 0:600 ]]
}

require_root_nonsecret_file() {
  local path=$1 mode
  [[ -f "$path" && ! -L "$path" ]]
  [[ "$(stat -c '%u' "$path")" == 0 ]]
  mode="$(stat -c '%a' "$path")"
  [[ "$mode" == 600 || "$mode" == 644 ]]
}

confirm_drill() {
  local confirmation
  [[ -r /dev/tty ]] || die "an interactive operator TTY is required"
  printf 'Type RESTORE %s to start the isolated drill: ' "$BACKUP_ID" >/dev/tty
  IFS= read -r confirmation </dev/tty
  [[ "$confirmation" == "RESTORE $BACKUP_ID" ]] || die "confirmation did not name the backup ID"
}

validate_custody_and_key() {
  local fs_type recipient recipient_id expected_id recorded_id
  require_root_file "$IDENTITY_SOURCE"
  require_root_file "$CUSTODY_RECORD"
  fs_type="$(findmnt -n -o FSTYPE -T "$IDENTITY_SOURCE")"
  [[ "$fs_type" == tmpfs || "$fs_type" == ramfs ]] ||
    die "operator age identity must be mounted on tmpfs"
  if grep -q 'AGE-SECRET-KEY-' "$CUSTODY_RECORD"; then
    die "custody evidence must not contain private key material"
  fi
  jq -e \
    --arg backup_id "$BACKUP_ID" '
      .schema == "age-key-custody.v1"
      and .backup_id == $backup_id
      and (.custodian | type == "string" and length > 0)
      and (.mounted_at | type == "string" and endswith("Z"))
      and (.recipient_id | type == "string" and test("^[0-9a-f]{64}$"))
    ' "$CUSTODY_RECORD" >/dev/null
  recipient="$(age-keygen -y "$IDENTITY_SOURCE")"
  [[ "$recipient" == age1* ]]
  recipient_id="$(printf '%s' "$recipient" | sha256sum | awk '{print $1}')"
  expected_id="$(jq -er '.age_recipient_id' "$MANIFEST")"
  recorded_id="$(jq -er '.recipient_id' "$CUSTODY_RECORD")"
  [[ "$recipient_id" == "$expected_id" && "$recipient_id" == "$recorded_id" ]]
}

copy_key_to_owned_tmpfs() {
  KEY_MOUNT="/run/gitea-restore-key-$RUN_ID"
  mkdir -m 0700 "$KEY_MOUNT"
  mount -t tmpfs -o size=1m,mode=0700,nosuid,nodev,noexec tmpfs "$KEY_MOUNT"
  KEY_MOUNTED=1
  KEY_COPY="$KEY_MOUNT/identity.txt"
  cp "$IDENTITY_SOURCE" "$KEY_COPY"
  chown root:root "$KEY_COPY"
  chmod 0600 "$KEY_COPY"
}

acquire_lease() {
  local lease_until tmp
  lease_until="$(date -u -d '+2 hours' +%Y-%m-%dT%H:%M:%SZ)"
  tmp="${MANIFEST}.lease-partial.$$"
  LEASE_TEMP=$tmp
  jq --arg lease_until "$lease_until" --arg run_id "$RUN_ID" '
    .lease_until = (
      if .lease_until != null and .lease_until > $lease_until
      then .lease_until else $lease_until end
    )
    | .referenced_by = ((.referenced_by + [$run_id]) | unique)
  ' "$MANIFEST" >"$tmp"
  chmod 0600 "$tmp"
  fsync_path "$tmp"
  mv -f "$tmp" "$MANIFEST"
  LEASE_TEMP=
  fsync_path "$BACKUP_DIR"
  LEASED=1
}

component_path() {
  local name=$1 count expected expected_size path
  count="$(jq --arg name "$name" '[.components[] | select(.name == $name)] | length' "$MANIFEST")"
  [[ "$count" == 1 ]] || die "component is missing or duplicated: $name"
  expected="$(jq -er --arg name "$name" '.components[] | select(.name == $name) | .sha256' "$MANIFEST")"
  expected_size="$(jq -er --arg name "$name" \
    '.components[] | select(.name == $name) | .size | select(type == "number" and . > 0)' \
    "$MANIFEST")"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]]
  path="$BACKUP_DIR/$name"
  [[ -f "$path" && ! -L "$path" ]]
  [[ "$(stat -c '%s' "$path")" == "$expected_size" ]]
  [[ "$(sha256sum "$path" | awk '{print $1}')" == "$expected" ]]
  printf '%s\n' "$path"
}

component_exists() {
  local name=$1
  [[ "$(jq --arg name "$name" '[.components[] | select(.name == $name)] | length' "$MANIFEST")" == 1 ]]
}

decrypt_component() {
  local name=$1 path
  path="$(component_path "$name")"
  age --decrypt --identity "$KEY_COPY" "$path"
}

create_owned_volume() {
  local suffix=$1 volume
  volume="gitea-restore-${RUN_ID}-${suffix}"
  if docker volume inspect "$volume" >/dev/null 2>&1; then
    die "refusing pre-existing restore volume: $volume"
  fi
  volume_is_live "$volume" && die "refusing live restore volume: $volume"
  OWNED_VOLUMES+=("$volume")
  docker volume create --label "com.211api.restore-run=$RUN_ID" "$volume" >/dev/null
  CREATED_VOLUME=$volume
}

restore_tar_to_volume() {
  local component=$1 volume=$2
  decrypt_component "$component" | python3 "$TAR_VALIDATOR" --profile volume >/dev/null
  decrypt_component "$component" |
    docker run --rm -i --read-only --network none \
      -v "$volume:/target" \
      "$APP_ALPINE_IMAGE" \
      tar -C /target -xf -
}

validate_host_archive() {
  python3 "$TAR_VALIDATOR" --profile host
}

restore_host_config() {
  local listing="$SCRATCH/host-config.list"
  decrypt_component host-config.tar.age | validate_host_archive >"$listing"
  decrypt_component host-config.tar.age | tar -C "$SCRATCH" --extract --file=- --no-same-owner
  rm -f -- "$listing"
  RESTORED_PLATFORM_ENV="$SCRATCH/etc/gitea/platform.env"
  RESTORED_IMAGE_LOCK="$SCRATCH/opt/gitea/images.lock.env"
  [[ -f "$RESTORED_PLATFORM_ENV" && ! -L "$RESTORED_PLATFORM_ENV" ]]
  [[ -f "$RESTORED_IMAGE_LOCK" && ! -L "$RESTORED_IMAGE_LOCK" ]]
  gitea_load_platform_env "$RESTORED_PLATFORM_ENV"
  gitea_load_image_lock "$RESTORED_IMAGE_LOCK"
}

env_value() {
  local key=$1 file=$2
  awk -v key="$key" '
    index($0, key "=") == 1 {
      if (seen++) exit 2
      print substr($0, length(key) + 2)
    }
    END { if (seen != 1) exit 1 }
  ' "$file"
}

scratch_path_for_original() {
  local original=$1
  if [[ "$original" != /* || "$original" == *$'\n'* || "$original" == *$'\r'* ||
    "$original" == *'/../'* || "$original" == */.. || "$original" == *//* ]]; then
    return 1
  fi
  printf '%s/%s\n' "$SCRATCH" "${original#/}"
}

prepare_restore_environment() {
  local original token
  original="$(env_value GITEA_DB_PASSWORD_FILE "$RESTORED_PLATFORM_ENV")"
  export RESTORE_DB_PASSWORD_FILE
  RESTORE_DB_PASSWORD_FILE="$(scratch_path_for_original "$original")"
  original="$(env_value GITEA_SECRET_KEY_FILE "$RESTORED_PLATFORM_ENV")"
  export RESTORE_SECRET_KEY_FILE
  RESTORE_SECRET_KEY_FILE="$(scratch_path_for_original "$original")"
  original="$(env_value GITEA_INTERNAL_TOKEN_FILE "$RESTORED_PLATFORM_ENV")"
  export RESTORE_INTERNAL_TOKEN_FILE
  RESTORE_INTERNAL_TOKEN_FILE="$(scratch_path_for_original "$original")"
  original="$(env_value GITEA_BACKUP_API_CONFIG "$RESTORED_PLATFORM_ENV")"
  RESTORED_API_CONFIG="$(scratch_path_for_original "$original")"
  require_root_file "$RESTORE_DB_PASSWORD_FILE"
  require_root_file "$RESTORE_SECRET_KEY_FILE"
  require_root_file "$RESTORE_INTERNAL_TOKEN_FILE"
  require_root_file "$RESTORED_API_CONFIG"

  token="$(sed -n -E 's/^header = "Authorization: token ([0-9A-Za-z_-]{20,256})"$/\1/p' \
    "$RESTORED_API_CONFIG")"
  [[ "$token" =~ ^[0-9A-Za-z_-]{20,256}$ ]]
  LOCAL_API_CONFIG="$SCRATCH/local-api.curl"
  printf 'header = "Authorization: token %s"\n' "$token" >"$LOCAL_API_CONFIG"
  LOCAL_REGISTRY_CONFIG="$SCRATCH/local-registry.curl"
  printf 'user = "svc-backup-read:%s"\n' "$token" >"$LOCAL_REGISTRY_CONFIG"
  chmod 0600 "$LOCAL_API_CONFIG" "$LOCAL_REGISTRY_CONFIG"

  export RESTORE_PROJECT="gitea-restore-$RUN_ID"
  export RESTORE_HTTP_PORT
  export RESTORE_POSTGRES_VOLUME
  export RESTORE_GITEA_DATA_VOLUME
  export RESTORE_GITEA_CONFIG_VOLUME
  export RESTORE_RUNTIME_SECRETS_VOLUME
}

choose_loopback_port() {
  python3 -c '
import socket
sock = socket.socket()
sock.bind(("127.0.0.1", 0))
print(sock.getsockname()[1])
sock.close()
'
}

wait_postgres() {
  local attempt
  for attempt in $(seq 1 60); do
    if compose_restore ps --status running --services 2>/dev/null | grep -qx postgres &&
      compose_restore exec -T postgres pg_isready -U gitea -d gitea >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_gitea() {
  local attempt
  for attempt in $(seq 1 120); do
    if curl --silent --show-error --fail --connect-timeout 2 --max-time 5 \
      "http://127.0.0.1:$RESTORE_HTTP_PORT/api/healthz" >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

api_local_get() {
  curl --config "$LOCAL_API_CONFIG" \
    --silent --show-error --fail \
    --connect-timeout 3 --max-time 20 \
    "http://127.0.0.1:$RESTORE_HTTP_PORT/api/v1$1"
}

paginated_local_array() {
  local endpoint=$1 page=1 body length first=1 separator
  printf '['
  while ((page <= 1000)); do
    [[ "$endpoint" == *\?* ]] && separator='&' || separator='?'
    body="$(api_local_get "${endpoint}${separator}page=$page&limit=50")"
    jq -e 'type == "array"' <<<"$body" >/dev/null
    length="$(jq -r 'length' <<<"$body")"
    while IFS= read -r item; do
      ((first)) || printf ','
      first=0
      printf '%s' "$item"
    done < <(jq -c '.[]' <<<"$body")
    ((length < 50)) && break
    page=$((page + 1))
  done
  ((page <= 1000))
  printf ']\n'
}

normalize_releases() {
  jq -S 'map({tag_name,target_commitish,name,draft,prerelease}) | sort_by(.tag_name)'
}

normalize_packages() {
  jq -S 'map({type,name,version}) | sort_by(.type,.name,.version)'
}

urlencode_segment() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

urlencode_registry_path() {
  python3 -c '
import sys
import urllib.parse
print("/".join(urllib.parse.quote(part, safe="") for part in sys.argv[1].split("/")))
' "$1"
}

registry_local_get() {
  curl --config "$LOCAL_REGISTRY_CONFIG" \
    --silent --show-error --fail \
    --connect-timeout 3 --max-time 30 \
    --header 'Accept: application/vnd.oci.image.index.v1+json' \
    --header 'Accept: application/vnd.oci.image.manifest.v1+json' \
    --header 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
    --header 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
    "http://127.0.0.1:$RESTORE_HTTP_PORT$1"
}

validate_container_manifest() {
  jq -e '
    .schemaVersion == 2
    and (.mediaType == "application/vnd.oci.image.index.v1+json"
      or .mediaType == "application/vnd.oci.image.manifest.v1+json"
      or .mediaType == "application/vnd.docker.distribution.manifest.list.v2+json"
      or .mediaType == "application/vnd.docker.distribution.manifest.v2+json")
    and ((.manifests | type == "array")
      or ((.config | type == "object") and (.layers | type == "array")))
  ' >/dev/null
}

verify_api_metadata() {
  local expected_releases expected_packages actual_releases actual_packages
  local encoded_type encoded_name encoded_version registry_name
  expected_releases="$SCRATCH/expected-releases.json"
  expected_packages="$SCRATCH/expected-packages.json"
  actual_releases="$SCRATCH/actual-releases.json"
  actual_packages="$SCRATCH/actual-packages.json"
  decrypt_component releases.json.age | normalize_releases >"$expected_releases"
  decrypt_component packages.json.age | normalize_packages >"$expected_packages"
  paginated_local_array /repos/211api/211api/releases | normalize_releases >"$actual_releases"
  paginated_local_array '/packages/211api?type=container' | normalize_packages >"$actual_packages"
  cmp -s "$expected_releases" "$actual_releases"
  cmp -s "$expected_packages" "$actual_packages"

  while IFS=$'\t' read -r type name version; do
    [[ "$type" == container ]]
    encoded_type="$(urlencode_segment "$type")"
    encoded_name="$(urlencode_segment "$name")"
    encoded_version="$(urlencode_segment "$version")"
    api_local_get "/packages/211api/$encoded_type/$encoded_name/$encoded_version" >/dev/null
    registry_name="$(urlencode_registry_path "$name")"
    registry_local_get "/v2/211api/$registry_name/manifests/$encoded_version" |
      validate_container_manifest
  done < <(jq -r '.[] | [.type,.name,.version] | @tsv' "$expected_packages")
}

verify_database_structure() {
  local table_count constraint_count
  table_count="$(compose_restore exec -T postgres psql -U gitea -d gitea -Atqc \
    "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE'")"
  constraint_count="$(compose_restore exec -T postgres psql -U gitea -d gitea -Atqc \
    "SELECT count(*) FROM pg_constraint WHERE connamespace = 'public'::regnamespace")"
  [[ "$table_count" =~ ^[0-9]+$ && "$constraint_count" =~ ^[0-9]+$ ]]
  ((table_count > 0 && constraint_count > 0))
}

verify_clone_and_refs() {
  local expected_refs="$SCRATCH/expected.refs"
  local actual_refs="$SCRATCH/actual.refs"
  local git_config="$SCRATCH/gitconfig"
  local token mirror="$SCRATCH/repository.git"
  decrypt_component refs.inventory.age >"$expected_refs"
  token="$(sed -n -E 's/^header = "Authorization: token ([0-9A-Za-z_-]{20,256})"$/\1/p' \
    "$LOCAL_API_CONFIG")"
  printf '[http]\n\textraHeader = Authorization: token %s\n' "$token" >"$git_config"
  chmod 0600 "$git_config"
  GIT_CONFIG_GLOBAL="$git_config" git clone --mirror \
    "http://127.0.0.1:$RESTORE_HTTP_PORT/211api/211api.git" "$mirror" >/dev/null
  git --git-dir="$mirror" for-each-ref \
    --format='%(objectname) %(refname)' refs/heads refs/tags | LC_ALL=C sort >"$actual_refs"
  cmp -s "$expected_refs" "$actual_refs"
}

restore_resources() {
  local caddy_data caddy_config runner_data
  create_owned_volume postgres
  RESTORE_POSTGRES_VOLUME=$CREATED_VOLUME
  create_owned_volume gitea-data
  RESTORE_GITEA_DATA_VOLUME=$CREATED_VOLUME
  create_owned_volume gitea-config
  RESTORE_GITEA_CONFIG_VOLUME=$CREATED_VOLUME
  create_owned_volume runtime-secrets
  RESTORE_RUNTIME_SECRETS_VOLUME=$CREATED_VOLUME
  create_owned_volume caddy-data
  caddy_data=$CREATED_VOLUME
  create_owned_volume caddy-config
  caddy_config=$CREATED_VOLUME

  restore_tar_to_volume volume-gitea-data.tar.age "$RESTORE_GITEA_DATA_VOLUME"
  restore_tar_to_volume volume-gitea-config.tar.age "$RESTORE_GITEA_CONFIG_VOLUME"
  restore_tar_to_volume volume-caddy-data.tar.age "$caddy_data"
  restore_tar_to_volume volume-caddy-config.tar.age "$caddy_config"
  if component_exists volume-runner-data.tar.age; then
    create_owned_volume runner-data
    runner_data=$CREATED_VOLUME
    restore_tar_to_volume volume-runner-data.tar.age "$runner_data"
  fi

  restore_host_config
  prepare_restore_environment
  RESTORE_HTTP_PORT="$(choose_loopback_port)"
  export RESTORE_HTTP_PORT

  COMPOSE_STARTED=1
  compose_restore up -d secret-init postgres
  wait_postgres
  decrypt_component postgres.dump.age |
    compose_restore exec -T postgres \
      pg_restore --exit-on-error --clean --if-exists --no-owner --no-privileges \
      -U gitea -d gitea
  compose_restore up -d gitea
  wait_gitea
}

verify_restored_state() {
  verify_database_structure
  api_local_get /user | jq -e '.login == "svc-backup-read" and .is_admin == false' >/dev/null
  verify_clone_and_refs
  verify_api_metadata
}

main() {
  local command_name
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
  umask 077
  [[ "$EUID" -eq 0 ]] || {
    printf 'gitea-restore-drill must run as root.\n' >&2
    exit 77
  }
  parse_args "$@"
  for command_name in age age-keygen awk cmp curl docker findmnt flock git jq mount od openssl python3 sed sha256sum tar umount; do
    command -v "$command_name" >/dev/null
  done

  BACKUP_DIR="$BACKUP_ROOT/$BACKUP_ID.validated"
  MANIFEST="$BACKUP_DIR/manifest.json"
  [[ -d "$BACKUP_DIR" && ! -L "$BACKUP_DIR" ]]
  [[ "$(stat -c '%u:%a' "$BACKUP_DIR")" == 0:700 ]]
  require_root_file "$MANIFEST"
  require_root_nonsecret_file "$IMAGE_LOCK"
  require_root_nonsecret_file "$RESTORE_COMPOSE_FILE"
  require_root_nonsecret_file "$STRICT_ENV_LOADER"
  require_root_nonsecret_file "$TAR_VALIDATOR"
  jq -e --arg backup_id "$BACKUP_ID" '
    .schema == "gitea-platform-backup.v1"
    and .backup_id == $backup_id
    and (.components | type == "array" and length > 0)
    and (.referenced_by | type == "array")
  ' "$MANIFEST" >/dev/null

  RUN_ID="$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
  RESTORE_PROJECT="gitea-restore-$RUN_ID"
  [[ ! -L "$BACKUP_LOCK" && ! -L "$SCRATCH_PARENT" ]] || die "unsafe restore state path"
  mkdir -p "$(dirname -- "$BACKUP_LOCK")" "$SCRATCH_PARENT"
  chmod 0700 "$SCRATCH_PARENT"
  [[ "$(stat -c '%u:%a' "$SCRATCH_PARENT")" == 0:700 ]]
  if [[ -e "$BACKUP_LOCK" ]]; then
    [[ -f "$BACKUP_LOCK" && ! -L "$BACKUP_LOCK" && "$(stat -c '%u' "$BACKUP_LOCK")" == 0 ]]
  fi
  exec 9>"$BACKUP_LOCK"
  flock -n 9 || exit 75
  trap cleanup EXIT
  trap 'on_signal 129' HUP
  trap 'on_signal 130' INT
  trap 'on_signal 143' TERM

  confirm_drill
  validate_custody_and_key
  acquire_lease
  copy_key_to_owned_tmpfs
  SCRATCH="$SCRATCH_PARENT/gitea-restore-$RUN_ID"
  mkdir -m 0700 "$SCRATCH"
  # Load only schema-checked, nonsecret image references used by extraction.
  # shellcheck source=strict-env.sh
  source "$STRICT_ENV_LOADER"
  gitea_load_image_lock "$IMAGE_LOCK"
  restore_resources
  verify_restored_state
  log "Restore drill passed for $BACKUP_ID."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
