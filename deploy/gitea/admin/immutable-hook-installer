#!/bin/sh

set -eu
umask 077

die() {
  printf 'immutable-hook-installer: %s\n' "$*" >&2
  exit 1
}

for command in realpath stat sha256sum wc mktemp cp chmod chown ln rm dirname id; do
  command -v "$command" >/dev/null 2>&1 ||
    die "required command is unavailable: $command"
done

require_regular() {
  path=$1
  [ -f "$path" ] && [ ! -L "$path" ] ||
    die "required regular non-symlink file is missing: $path"
}

require_canonical_existing_path() {
  path=$1
  resolved=$(realpath "$path") || die "cannot resolve path: $path"
  [ "$resolved" = "$path" ] || die "path contains a symlink or is not canonical: $path"
}

validate_repository() {
  [ "$repository" = "$expected_repository" ] ||
    die 'repository path is not the exact expected bare path'
  require_canonical_existing_path "$repository"
  [ -d "$repository" ] || die 'bare repository directory is missing'
  [ "$(stat -c '%u:%g' "$repository")" = "$owner_uid:$owner_gid" ] ||
    die 'bare repository owner is unexpected'
  require_regular "$repository/HEAD"
  [ -d "$repository/objects" ] && [ ! -L "$repository/objects" ] ||
    die 'bare repository objects directory is unsafe'
  [ -d "$repository/hooks/update.d" ] && [ ! -L "$repository/hooks/update.d" ] ||
    die 'managed update.d directory is missing or is a symlink'
  require_canonical_existing_path "$repository/hooks/update.d"
  [ "$(stat -c '%u:%g' "$repository/hooks/update.d")" = "$owner_uid:$owner_gid" ] ||
    die 'managed update.d directory owner is unexpected'
  require_regular "$repository/hooks/update.d/gitea"
  require_canonical_existing_path "$repository/hooks/update.d/gitea"
  [ -x "$repository/hooks/update.d/gitea" ] || die 'managed Gitea hook is not executable'
  [ "$(stat -c '%u:%g' "$repository/hooks/update.d/gitea")" = "$owner_uid:$owner_gid" ] ||
    die 'managed Gitea hook owner is unexpected'
}

validate_source() {
  checksum_line=
  require_regular "$source_hook"
  require_canonical_existing_path "$source_hook"
  [ -x "$source_hook" ] || die 'reviewed immutable hook source is not executable'
  checksum_line=$(sha256sum "$source_hook") ||
    die 'cannot calculate reviewed immutable hook checksum'
  source_checksum=${checksum_line%% *}
  case "$source_checksum" in
    [0-9a-f][0-9a-f]*) ;;
    *) die 'cannot calculate reviewed immutable hook checksum' ;;
  esac
  [ "${#source_checksum}" -eq 64 ] || die 'reviewed immutable hook checksum is invalid'
}

validate_checksum_record() {
  require_regular "$checksum_record"
  require_canonical_existing_path "$checksum_record"
  [ "$(stat -c '%u:%g %a' "$checksum_record")" = "$record_uid:$record_gid 600" ] ||
    die 'immutable hook checksum record owner or mode drifted'
  [ "$(wc -l <"$checksum_record")" -eq 1 ] ||
    die 'immutable hook checksum evidence has unexpected line count'
  IFS= read -r recorded_checksum <"$checksum_record" ||
    die 'cannot read immutable hook checksum evidence'
  [ "$recorded_checksum" = "$source_checksum  $target" ] ||
    die 'immutable hook checksum evidence drifted'
}

validate_installed() {
  target="$repository/hooks/update.d/immutable-v-tags"
  checksum_line=$(sha256sum "$source_hook") || die 'cannot re-check reviewed hook source'
  current_source_checksum=${checksum_line%% *}
  [ "$current_source_checksum" = "$source_checksum" ] ||
    die 'reviewed immutable hook source changed during verification'
  require_regular "$target"
  require_canonical_existing_path "$target"
  [ -x "$target" ] || die 'installed immutable hook is not executable'
  [ "$(stat -c '%u:%g %a' "$target")" = "$owner_uid:$owner_gid 755" ] ||
    die 'installed immutable hook owner or mode drifted'
  checksum_line=$(sha256sum "$target") || die 'cannot checksum installed immutable hook'
  target_checksum=${checksum_line%% *}
  [ "$target_checksum" = "$source_checksum" ] ||
    die 'installed immutable hook checksum drifted from reviewed source'
  validate_checksum_record
}

install_hook() {
  target="$repository/hooks/update.d/immutable-v-tags"
  record_parent=$(dirname "$checksum_record")

  if [ ! -e "$record_parent" ] && [ "$mode" = --production-install ]; then
    mkdir -m 0700 "$record_parent"
    chown "$record_uid:$record_gid" "$record_parent"
  fi
  [ -d "$record_parent" ] && [ ! -L "$record_parent" ] ||
    die 'checksum evidence directory is missing or is a symlink'
  require_canonical_existing_path "$record_parent"
  [ "$(stat -c '%u:%g %a' "$record_parent")" = "$record_uid:$record_gid 700" ] ||
    die 'checksum evidence directory owner or mode drifted'
  [ ! -L "$target" ] && [ ! -L "$checksum_record" ] ||
    die 'refusing a symlink install or evidence target'

  if [ -e "$target" ] || [ -e "$checksum_record" ]; then
    if [ -e "$target" ] && [ -e "$checksum_record" ]; then
      validate_installed
      return 0
    fi
    [ ! -e "$target" ] && [ -e "$checksum_record" ] ||
      die 'hook exists without its checksum evidence'
    validate_checksum_record
  fi
  target_partial=$(mktemp "$repository/hooks/update.d/.immutable-v-tags.XXXXXX") ||
    die 'cannot create an atomic immutable hook staging file'
  cp "$source_hook" "$target_partial"
  checksum_line=$(sha256sum "$target_partial") || die 'cannot checksum staged immutable hook'
  staged_checksum=${checksum_line%% *}
  checksum_line=$(sha256sum "$source_hook") || die 'cannot re-check reviewed hook source'
  source_checksum_after=${checksum_line%% *}
  [ "$staged_checksum" = "$source_checksum" ] &&
    [ "$source_checksum_after" = "$source_checksum" ] ||
    die 'reviewed immutable hook source changed during staging'
  chmod 0755 "$target_partial"
  if [ "$(id -u)" -eq 0 ]; then
    chown "$owner_uid:$owner_gid" "$target_partial"
  fi
  [ "$(stat -c '%u:%g %a' "$target_partial")" = "$owner_uid:$owner_gid 755" ] ||
    die 'cannot stage immutable hook with exact owner and mode'
  ln "$target_partial" "$target" || die 'immutable hook target appeared during installation'
  target_created=1

  if [ ! -e "$checksum_record" ]; then
    record_partial=$(mktemp "$record_parent/.immutable-v-tags.XXXXXX") ||
      die 'cannot create an atomic checksum-evidence staging file'
    printf '%s  %s\n' "$source_checksum" "$target" >"$record_partial"
    chmod 0600 "$record_partial"
    if [ "$(id -u)" -eq 0 ]; then
      chown "$record_uid:$record_gid" "$record_partial"
    fi
    ln "$record_partial" "$checksum_record" ||
      die 'checksum evidence target appeared during installation'
  fi
  target_created=0
  rm -f -- "$target_partial"
  target_partial=
  if [ -n "$record_partial" ]; then
    rm -f -- "$record_partial"
    record_partial=
  fi
  validate_installed
}

target_partial=
record_partial=
target_created=0
cleanup_partials() {
  if [ "$target_created" -eq 1 ] && [ -n "$target_partial" ] &&
    [ -e "${target:-}" ] && [ "$target" -ef "$target_partial" ]; then
    rm -f -- "$target"
  fi
  [ -z "$target_partial" ] || rm -f -- "$target_partial"
  [ -z "$record_partial" ] || rm -f -- "$record_partial"
}
trap cleanup_partials 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

mode=${1:-}
case "$mode" in
  --production-install|--production-verify)
    [ "$#" -eq 1 ] || die 'production mode accepts no path arguments'
    [ "$(id -u)" -eq 0 ] || die 'production installation is root-only'
    repository=/var/lib/gitea/git/repositories/211api/211api.git
    expected_repository=/var/lib/gitea/git/repositories/211api/211api.git
    source_hook=/source/immutable-v-tags
    checksum_record=/var/lib/gitea/.platform/immutable-v-tags.sha256
    owner_uid=1000
    owner_gid=1000
    record_uid=0
    record_gid=0
    ;;
  --fixture-install|--fixture-verify)
    [ "${GITEA_HOOK_INSTALL_FIXTURE:-}" = 1 ] ||
      die 'fixture mode requires GITEA_HOOK_INSTALL_FIXTURE=1'
    [ "$#" -eq 7 ] ||
      die 'fixture mode requires repository expected-path source record uid gid'
    repository=$2
    expected_repository=$3
    source_hook=$4
    checksum_record=$5
    owner_uid=$6
    owner_gid=$7
    record_uid=$(id -u)
    record_gid=$(id -g)
    ;;
  *) die 'expected --production-install, --production-verify, --fixture-install, or --fixture-verify' ;;
esac

for path in "$repository" "$expected_repository" "$source_hook" "$checksum_record"; do
  case "$path" in
    /*) ;;
    *) die 'all immutable hook paths must be absolute' ;;
  esac
done

validate_source
validate_repository
case "$mode" in
  --production-install|--fixture-install) install_hook ;;
  --production-verify|--fixture-verify) validate_installed ;;
esac

printf '%s\n' 'immutable v* tag hook verified'
