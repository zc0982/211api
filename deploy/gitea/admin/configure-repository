#!/usr/bin/env bash

set -euo pipefail
umask 077

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=admin-lib.sh
source "$SCRIPT_DIR/admin-lib.sh"

usage() {
  printf 'Usage: %s --base | --activate-main STATUS_CONTEXT_EVIDENCE\n' "$0" >&2
  exit 2
}

mode=
context_evidence=
case ${1:-} in
  --base)
    [[ $# -eq 1 ]] || usage
    mode=base
    ;;
  --activate-main)
    [[ $# -eq 2 ]] || usage
    mode=activate-main
    context_evidence=$2
    ;;
  *) usage ;;
esac

gitea_require_root
gitea_require_commands docker curl jq grep stat cmp
gitea_require_root_file "$GITEA_IMAGE_LOCK" 644
gitea_require_root_secret "$GITEA_PLATFORM_ENV"
gitea_require_root_file "$GITEA_PLATFORM_COMPOSE" 644
gitea_validate_admin_control_record

runtime=$(gitea_make_runtime)
cleanup() {
  rm -rf -- "$runtime"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

gitea_validate_cli_contract "$runtime"
gitea_validate_openapi "$runtime"

status=$(gitea_api_status "$GITEA_ADMIN_CURL_CONFIG" GET \
  "/repos/$GITEA_ORG/$GITEA_REPO" "$runtime/repository-before.json") ||
  gitea_die 'failed to inspect repository before configuration'
gitea_expect_status "$status" 200 'GET canonical repository before configuration'
jq -e --arg owner "$GITEA_ORG" --arg repo "$GITEA_REPO" '
  .owner.login == $owner
  and .name == $repo
  and .private == true
  and (.mirror != true)
' "$runtime/repository-before.json" >/dev/null ||
  gitea_die 'refusing to configure an unexpected, public, or mirrored repository'

load_branch_protections() {
  gitea_api_get_all "$GITEA_ADMIN_CURL_CONFIG" \
    "/repos/$GITEA_ORG/$GITEA_REPO/branch_protections" \
    "$runtime/branch-protections.json" "$runtime" branch-protections
}

ensure_branch_protection() {
  local rule=$1 template=$2 assertion=$3 output="$runtime/branch-$4.json" status count unknown
  load_branch_protections
  unknown=$(jq -r '[.[] | select(
    ((.rule_name // .branch_name) != "main")
    and ((.rule_name // .branch_name) != "release/v*")
  )] | length' "$runtime/branch-protections.json")
  [[ "$unknown" == 0 ]] || gitea_die 'unreviewed branch-protection rule exists'
  count=$(jq -r --arg rule "$rule" \
    '[.[] | select((.rule_name // .branch_name) == $rule)] | length' \
    "$runtime/branch-protections.json")
  case "$count" in
    0)
      status=$(gitea_api_status "$GITEA_ADMIN_CURL_CONFIG" POST \
        "/repos/$GITEA_ORG/$GITEA_REPO/branch_protections" "$output" "$template") ||
        gitea_die "failed to create branch protection $rule"
      gitea_expect_status "$status" 201 "POST branch protection $rule"
      ;;
    1)
      jq -e --arg rule "$rule" \
        '.[] | select((.rule_name // .branch_name) == $rule)' \
        "$runtime/branch-protections.json" >"$output"
      ;;
    *) gitea_die "duplicate branch-protection rule: $rule" ;;
  esac
  "$assertion" "$output"
}

validate_branch_rule_set() {
  local require_main=$1 release_count main_count total
  load_branch_protections
  release_count=$(jq -r \
    '[.[] | select((.rule_name // .branch_name) == "release/v*")] | length' \
    "$runtime/branch-protections.json")
  main_count=$(jq -r \
    '[.[] | select((.rule_name // .branch_name) == "main")] | length' \
    "$runtime/branch-protections.json")
  total=$(jq -r 'length' "$runtime/branch-protections.json")
  [[ "$release_count" == 1 ]] || gitea_die 'release/v* branch rule is missing or duplicated'
  [[ "$main_count" == 0 || "$main_count" == 1 ]] ||
    gitea_die 'main branch rule is duplicated'
  [[ "$total" -eq $((release_count + main_count)) ]] ||
    gitea_die 'unreviewed branch-protection rule exists'
  if [[ "$require_main" == true && "$main_count" != 1 ]]; then
    gitea_die 'main branch rule was not activated'
  fi
  jq -e '.[] | select((.rule_name // .branch_name) == "release/v*")' \
    "$runtime/branch-protections.json" >"$runtime/branch-release-validated.json"
  gitea_assert_release_protection "$runtime/branch-release-validated.json"
  if [[ "$main_count" == 1 ]]; then
    jq -e '.[] | select((.rule_name // .branch_name) == "main")' \
      "$runtime/branch-protections.json" >"$runtime/branch-main-validated.json"
    gitea_assert_main_protection "$runtime/branch-main-validated.json"
  fi
}

ensure_tag_protection() {
  local output="$runtime/tag-v.json" status count total
  gitea_api_get_all "$GITEA_ADMIN_CURL_CONFIG" \
    "/repos/$GITEA_ORG/$GITEA_REPO/tag_protections" \
    "$runtime/tag-protections.json" "$runtime" tag-protections
  count=$(jq -r '[.[] | select(.name_pattern == "v*")] | length' \
    "$runtime/tag-protections.json")
  total=$(jq -r 'length' "$runtime/tag-protections.json")
  [[ "$count" != 0 || "$total" == 0 ]] ||
    gitea_die 'refusing to create v* beside an unreviewed tag-protection rule'
  case "$count" in
    0)
      status=$(gitea_api_status "$GITEA_ADMIN_CURL_CONFIG" POST \
        "/repos/$GITEA_ORG/$GITEA_REPO/tag_protections" "$output" \
        "$SCRIPT_DIR/templates/tag-v.json") ||
        gitea_die 'failed to create v* tag protection'
      gitea_expect_status "$status" 201 'POST v* tag protection'
      ;;
    1)
      jq -e '.[] | select(.name_pattern == "v*")' \
        "$runtime/tag-protections.json" >"$output"
      ;;
    *) gitea_die 'duplicate v* tag-protection rules' ;;
  esac
  gitea_assert_tag_protection "$output"
  gitea_api_get_all "$GITEA_ADMIN_CURL_CONFIG" \
    "/repos/$GITEA_ORG/$GITEA_REPO/tag_protections" \
    "$runtime/tag-protections-final.json" "$runtime" tag-protections-final
  jq -e 'length == 1 and .[0].name_pattern == "v*"' \
    "$runtime/tag-protections-final.json" >/dev/null ||
    gitea_die 'unreviewed or duplicate tag-protection rule exists'
}

put_actions_secret() {
  local name=$1 token_file=$2 status
  local output="$runtime/secret-$name.json"
  gitea_require_root_secret "$token_file"
  jq -Rs '{data:(gsub("[\\r\\n]+$"; ""))}' <"$token_file" \
    >"$runtime/secret-$name.body.json"
  status=$(gitea_api_status "$GITEA_ADMIN_CURL_CONFIG" PUT \
    "/repos/$GITEA_ORG/$GITEA_REPO/actions/secrets/$name" "$output" \
    "$runtime/secret-$name.body.json") ||
    gitea_die "failed to install Actions secret $name"
  gitea_expect_one_of_statuses "$status" "PUT Actions secret $name" 201 204
}

verify_actions_secret_names() {
  gitea_api_get_all "$GITEA_ADMIN_CURL_CONFIG" \
    "/repos/$GITEA_ORG/$GITEA_REPO/actions/secrets" \
    "$runtime/action-secrets.json" "$runtime" action-secrets
  gitea_assert_actions_secret_names "$runtime/action-secrets.json" false
}

if [[ "$mode" == base ]]; then
  status=$(gitea_api_status "$GITEA_ADMIN_CURL_CONFIG" PATCH \
    "/repos/$GITEA_ORG/$GITEA_REPO" "$runtime/repository-after.json" \
    "$SCRIPT_DIR/templates/repository-settings.json") ||
    gitea_die 'failed to enforce repository settings'
  gitea_expect_status "$status" 200 'PATCH canonical repository settings'
  gitea_assert_repository_shape "$runtime/repository-after.json"

  ensure_branch_protection release/v\* "$SCRIPT_DIR/templates/branch-release.json" \
    gitea_assert_release_protection release
  validate_branch_rule_set false
  ensure_tag_protection
  put_actions_secret REGISTRY_BUILD_TOKEN "$GITEA_TOKEN_DIR/registry-build.token"
  put_actions_secret REGISTRY_RELEASE_TOKEN "$GITEA_TOKEN_DIR/registry-release.token"
  put_actions_secret RELEASE_RECORD_TOKEN "$GITEA_TOKEN_DIR/release-record.token"
  verify_actions_secret_names
  printf '%s\n' 'Base repository controls and split PAT secrets passed.'
else
  gitea_require_root_secret "$context_evidence"
  cat >"$runtime/required-contexts.expected" <<'EOF'
ci / required
security / required
EOF
  cmp -- "$runtime/required-contexts.expected" "$context_evidence" >/dev/null ||
    gitea_die 'status-context evidence is not exactly the two reviewed Task 11 contexts'
  ensure_branch_protection main "$SCRIPT_DIR/templates/branch-main.json" \
    gitea_assert_main_protection main
  validate_branch_rule_set true
  ensure_tag_protection
  printf '%s\n' 'Main protection activated with the proved status contexts.'
fi
