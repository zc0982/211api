#!/usr/bin/env bash

set -euo pipefail
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset BASH_ENV ENV CDPATH GLOBIGNORE

readonly RUNTIME_LIBRARY=/etc/211api-deploy/gateway-runtime.sh
[[ $# == 4 && "$1" == --max-size && "$2" == 10485760 &&
  "$3" == --rotate && "$4" == 10 ]] || {
  printf 'gateway-audit-rotate: invalid rotation contract\n' >&2
  exit 64
}
[[ -f "$RUNTIME_LIBRARY" && ! -L "$RUNTIME_LIBRARY" &&
  "$(stat -c '%u:%g:%a' "$RUNTIME_LIBRARY")" == 0:0:600 ]] || {
  printf 'gateway-audit-rotate: unsafe runtime library\n' >&2
  exit 1
}
# shellcheck source=gateway-runtime.sh
source "$RUNTIME_LIBRARY"
gateway_runtime_init
gateway_require_directory "$CONFIG_ROOT" 700
gateway_require_directory "$AUDIT_DIR" 700
gateway_require_host_directory "$LOCK_ROOT"
gateway_require_regular "$AUDIT_FILE" 600
gateway_prepare_lock_file "$AUDIT_LOCK"
exec 9>"$AUDIT_LOCK"
flock -x 9
gateway_rotate_audit_locked
