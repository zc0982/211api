#!/usr/bin/env bash

set -euo pipefail
umask 077

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset BASH_ENV ENV CDPATH GLOBIGNORE

readonly EXPECTED_SOURCE=37.221.194.27
readonly PRODUCTION_PROGRAM=/usr/local/sbin/211api-deploy

reject() {
  printf '211api-deploy-dispatch: command rejected\n' >&2
  exit 64
}

[[ -z "${SSH_TTY:-}" && -z "${SSH_AUTH_SOCK:-}" && -z "${DISPLAY:-}" ]] || reject
[[ -n "${SSH_CONNECTION:-}" && "$SSH_CONNECTION" != *[$'\n\r\t']* ]] || reject
read -r -a connection_fields <<<"$SSH_CONNECTION"
((${#connection_fields[@]} == 4)) || reject
[[ "${connection_fields[0]}" == "$EXPECTED_SOURCE" ]] || reject
for port in "${connection_fields[1]}" "${connection_fields[3]}"; do
  [[ "$port" =~ ^[0-9]{1,5}$ ]] || reject
  ((10#$port >= 1 && 10#$port <= 65535)) || reject
done

[[ -n "${SSH_ORIGINAL_COMMAND:-}" &&
  "$SSH_ORIGINAL_COMMAND" != *[$'\n\r\t\0']* &&
  ${#SSH_ORIGINAL_COMMAND} -le 192 ]] || reject

declare -a command_argv
if [[ "$SSH_ORIGINAL_COMMAND" == status ]]; then
  command_argv=(status)
elif [[ "$SSH_ORIGINAL_COMMAND" =~ ^deploy\ --commit\ ([0-9a-f]{40})\ --digest\ (sha256:[0-9a-f]{64})$ ]]; then
  command_argv=(deploy --commit "${BASH_REMATCH[1]}" --digest "${BASH_REMATCH[2]}")
else
  reject
fi

program=$PRODUCTION_PROGRAM
home=/root
user=root
if [[ "${GATEWAY_DEPLOY_DISPATCH_TESTING:-0}" == 1 ]]; then
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
  [[ "$script_dir" != /usr/local/sbin ]] || reject
  program=${GATEWAY_DEPLOY_DISPATCH_TEST_PROGRAM:-}
  [[ "$program" == /tmp/* && -f "$program" && ! -L "$program" && -x "$program" ]] || reject
  [[ "$(stat -c '%u' "$program")" == "$EUID" ]] || reject
  home=/nonexistent
  user="$(id -un)"
else
  ((EUID == 0)) || reject
  [[ -x "$program" && -f "$program" && ! -L "$program" ]] || reject
  [[ "$(stat -c '%u:%g:%a' "$program")" == 0:0:755 ]] || reject
fi

exec env -i \
  HOME="$home" \
  USER="$user" \
  LOGNAME="$user" \
  PATH=/usr/sbin:/usr/bin:/sbin:/bin \
  GATEWAY_DEPLOY_DISPATCH=1 \
  GATEWAY_DEPLOY_SOURCE_IP="$EXPECTED_SOURCE" \
  "$program" "${command_argv[@]}"
